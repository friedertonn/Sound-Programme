00000h                                                           ;DEMO-BETRIEB DER K1520-SOUNDKARTE AM AC1
00000h                                                           ;BENUTZT AYPLAC1.INC
00000h                                                           ;WeRo, 1/2018
00000h                                                           ;Assembler: ASIde
00000h                                                           ;version:    EQU  0             ;int. CTC AC1, K0
00000h            VERSION:              EQU       1              ;CTC auf Soundkarte
00000h                                                           ;-------------------------------------------------
00000h                                                           ;VERSION 1.3:
00000h                                                           ;Anpassung für AC1-2010 mit 4 MHz CPU-Takt (05/2022):
00000h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
00000h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
00000h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
00000h                                                           ;  der Sound-Leiterplatte
00000h                                                           ;* Änderungen in der ISR-Routine bei der Int.-Annahme
00000h                                                           ;-------------------------------------------------
00000h                                                           ;AC1-Monitor spezifisch--------------------------
00000h            BWS:                  EQU       17FFH          ;links oben, rückwärts
00000h            CURS:                 EQU       1800H
00000h                                                           ;-------------------------------------------------
00000h                                                           ;IN INCLUDE FESTGELEGT:
00000h                                                           ;X0001: EQU     38h             ;AY-BASISADRESSE 
00000h                                                           ;------------------------------------------------
00000h                                                           ;Für Include nötig:
00000h                                  IF        VERSION=0
00000h            CTCBAS:               EQU       0              ;CTC-Basisadresse
00000h            CTCCHN:               EQU       0              ;Kanal
00000h                                  ELSE      
00000h            CTCBAS:               EQU       3CH            ;CTC-Basisadresse
00000h            CTCCHN:               EQU       0              ;Kanal
00000h                                  ENDIF     
00000h            ZKCTC:                EQU       9CH            ;Zeitkonstante für 2 MHz
00000h            PROGR:                EQU       2000H
00000h            CTCINT:               EQU       PROGR+10H      ;Interrupttabelle CTC
00000h            WORK:                 EQU       PROGR+18H      ;Eingebettete Arbeitszellen
00000h                                                           ;-------------------------------------------------
00000h                                                           ;Q358:         EQU  0  ;nutzt AC1-Systemtakt 2 MHz
00000h                                                           ;höherer CPU-Takt führt zum
00000h                                                           ;schnelleren Abspielen
00000h            Q358:                 EQU       1              ;benutzt Quarz 3,57954 MHz
00000h                                                           ;CTC K0+K1 sind kaskadiert
00000h                                                           ;CPU-Takt ist variabel
00000h                                                           ;-------------------------------------------------
00000h                                  ORG       PROGR          ;Programmanfang
02000h 0009610D                         DEFB      0,9,"a",0DH    ;Startrahmen, Kennbuchstabe a
02004h 3E20                             LD        A,HI PROGR     ;20h
02006h ED47                             LD        I,A            ;IV-Säule verbiegen
02008h 310020                           LD        SP,PROGR       ;Stack: < 2000
0200Bh C33225                           JP        START
0200Eh                                                           ;-------------------------------------------------
0200Eh 0000                             ORG       CTCINT         ;8 Bytes für IV CTC
02010h                                                           ;-------------------------------------------------
02010h 0000000000                       ORG       WORK           ;Raum für Arbeitszellen
02018h 0000000000                       DEFS      72
02060h                                                           ;BEZÜGE:
02060h                                                           ;WORK:                          ;Übergabe Lied-/Geräuschanfang
02060h                                                           ;WORK+2                         ;Übergabe Anzahl Liedabspiele
02060h                                                           ;-------------------------------------------------      
02060h            PLAYER:                         
02060h                                  INCLUDE   "AYPLAC1.INC"
02060h                                                           ;#################################################
02060h                                                           ;INCLUDE-FILE "PLAYER-ENGINE"
02060h                                                           ;FÜR STC-PLAYER MIT AY-3-8910 
02060h                                                           ;Version für AC1
02060h                                                           ;#################################################
02060h                                                           ;-------------------------------------------------
02060h                                                           ;ORIGINAL-VERÖFFENTLICHUNGEN:
02060h                                                           ;"MUSIK-TÜRKLINGEL MIT DEM AUDIO-COPROZESSOR AY8910"
02060h                                                           ;MAGAZIN 'RADIO', 1998/6, S. 42 + 43 (RUSSISCH)
02060h                                                           ;http://www.radioman-portal.ru/magazin/radio/1998/6.php
02060h                                                           ;
02060h                                                           ;ABSPIELROUTINE FÜR ZX81 MIT AY-3-8910-ADAPTER
02060h                                                           ;http://www.sinclairzxworld.com/viewtopic.php?t=528&start=100
02060h                                                           ;-------------------------------------------------
02060h                                                           ;PRINZIP CTC-TEIL: ENTWICKLERTEAM "M066"
02060h                                                           ;BEARBEITUNG, INCLUDE UND DOKU: WERO 10/2017
02060h                                                           ;ASSEMBLER: ASIDE
02060h                                                           ;-------------------------------------------------
02060h                                                           ;VERSION 1.1:
02060h                                                           ;* ISR GEÄNDERT
02060h                                                           ;* ARBEITSZELLEN STC-PLAYER VOR START GELÖSCHT
02060h                                                           ;* MISCHERBITS PORTREGISTER: BEI SONG-START/ENDE AUF EINGABE
02060h                                                           ;-------------------------------------------------
02060h                                                           ;VERSION 1.2:
02060h                                                           ;* MISCHERBITS PORTREGISTER: BLEIBEN IMMER UNANGETASTET
02060h                                                           ;Version 1.2.13
02060h                                                           ;KW 19.11.2017 (Klaus Wilfling)
02060h                                                           ;Anpassungen an K1520-SOUND-Karte 
02060h                                                           ;Bastelsystem mit ZRE K2526 unter CP/A, SCPX 
02060h                                                           ;SOUND-CTC Interruptsäule-F7D8h I=F7h, IV=D8h
02060h                                                           ;IO-Adresse der SOUND-Karte = 38h
02060h                                                           ;SOUND-Karten CTC Kanal 0 als 20ms Zeitgeber
02060h                                                           ;Version 1.2.14
02060h                                                           ;KW 03.02.2018
02060h                                                           ;Anpassung an unterschiedliche Rechnersysteme unter CP/M Klone
02060h                                                           ;Anpasssung wegen Problemen mit K8915 unter SCP8915
02060h                                                           ;zusätzlicher Stack für Interruptroutine für SCPX empfohlen
02060h                                                           ;-------------------------------------------------
02060h                                                           ;VERSION 1.3:
02060h                                                           ;Anpassung für AC1-2010 mit 4 MHz CPU-Takt (05/2022):
02060h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
02060h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
02060h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
02060h                                                           ;  der Sound-Leiterplatte
02060h                                                           ;* Änderungen in der ISR-Routine bei der Int.-Annahme
02060h                                                           ;-------------------------------------------------
02060h                                                           ;ANFORDERUNGEN AN HAUPTPROGRAMM:
02060h                                                           ;* DARF LABELS X0001...X0087 NICHT BENUTZEN
02060h                                                           ;* MUSS ARBEITSZELLENBEGINN MIT LABEL 'WORK' DEFINIEREN!
02060h                                                           ;* MUSS FOLGENDE KONSTANTEN BEREITSTELLEN:
02060h                                                           ;CTCBAS: EQU     0                  ;CTC-Basisadresse
02060h                                                           ;CTCCHN: EQU     3                  ;CTC-Kanal
02060h                                                           ;CTCZK:  EQU     9Ch                ;CTC-Zeitkonstante
02060h                                                           ;CTCINT: EQU     PROGR+10h          ;LAGE Interrupttabelle CTC
02060h                                                           ;                         (8er Schritte, I-Register beachten!)
02060h                                                           ;Q358:   EQU     1                  ;CTC-Kaskadierung K0+K1
02060h                                                           ;-------------------------------------------------
02060h                                                           ;SOFERN 38H NICHT GEEIGNET, MUSS BASISADRESSE HIER ANGEPASST WERDEN:
02060h            X0001:                EQU       #38            ;AY-BASISADRESSE  (K1520-SOUND)
02060h                                                           ;-------------------------------------------------
02060h                                                           ;PLAYER-AREBEITSZELLEN AB WORK
02060h            X0004:                EQU       WORK           ;WORD   ;WORK     ABLAGE LIEDANFANG   
02060h            X0005:                EQU       X0004+2        ;BYTE   ;WORK+#02 ABLAGE ANZAHL SONG-WIEDERHOLUNGEN 
02060h            X0006:                EQU       X0005+1        ;WORD   ;WORK+#03 POSITIONS-ZEIGER
02060h            X0007:                EQU       X0006+2        ;WORD   ;WORK+#05 ORNAMENT-ZEIGER      
02060h            X0008:                EQU       X0007+2        ;WORD   ;WORK+#07 PATTERN-ZEIGER       
02060h            X0009:                EQU       X0008+2        ;WORD   ;WORK+#09 POINTER 1. SAMPLE NR       
02060h            X0010:                EQU       X0009+2        ;BYTE   ;WORK+#0B GLOBAL DELAY SONG  
02060h            X0011:                EQU       X0010+1        ;BYTE   ;WORK+#0C GLOBAL DELAY WORK
02060h            X0012:                EQU       X0011+1        ;BYTE   ;WORK+#0D ANZAHL  PATTERN IM SONG 
02060h            X0013:                EQU       X0012+1        ;WORD   ;WORK+#0E ADRESSE PATTERN KANAL A 
02060h            X0014:                EQU       X0013+2        ;WORD   ;WORK+#10 ADRESSE PATTERN KANAL B
02060h            X0015:                EQU       X0014+2        ;WORD   ;WORK+#12 ADRESSE PATTERN KANAL C
02060h            X0016:                EQU       X0015+2        ;BYTE   ;WORK+#14 ENDEMARKE (FF)
02060h            X0017:                EQU       X0016+1        ;WORD   ;WORK+#15
02060h                                                           ;KANAL A------------------------------------------
02060h            X0018:                EQU       X0017+2        ;BYTE   ;WORK+#17 INDEX A
02060h                                                           ;BYTE   ;WORK+#18 NOTENNNUMMER
02060h                                                           ;BYTE   ;WORK+#19 PAUSE ZWISCHEN NOTEN
02060h            X0019:                EQU       X0018+3        ;WORD   ;WORK+#1A SAMPLEADRESSE
02060h            X0020:                EQU       X0019+2        ;WORD   ;WORK+#1C ORNAMENTADRESSE
02060h            X0021:                EQU       X0020+2        ;3XBYTE ;WORK+#1E 
02060h                                                           ;KANAL B------------------------------------------
02060h            X0022:                EQU       X0021+3        ;BYTE   ;WORK+#21 INDEX B
02060h                                                           ;BYTE   ;WORK+#22 NOTENNNUMMER
02060h                                                           ;BYTE   ;WORK+#23 PAUSE ZWISCHEN NOTEN
02060h            X0023:                EQU       X0022+3        ;WORD   ;WORK+#24 SAMPLEADRESSE
02060h            X0024:                EQU       X0023+2        ;WORD   ;WORK+#26 ORNAMENTADRESSE
02060h            X0025:                EQU       X0024+2        ;3XBYTE ;WORK+#28
02060h                                                           ;KANAL C------------------------------------------
02060h            X0026:                EQU       X0025+3        ;BYTE   ;WORK+#2B INDEX C
02060h                                                           ;BYTE   ;WORK+#2C NOTENNNUMMER
02060h                                                           ;BYTE   ;WORK+#2D PAUSE ZWISCHEN NOTEN
02060h            X0027:                EQU       X0026+3        ;WORD   ;WORK+#2E SAMPLEADRESSE
02060h            X0028:                EQU       X0027+2        ;WORD   ;WORK+#30 ORNAMENTADRESSE
02060h            X0029:                EQU       X0028+2        ;3XBYTE ;WORK+#32
02060h                                                           ;-------------------------------------------------
02060h            X0030:                EQU       X0029+3        ;BYTE   ;WORK+#35 ABGESPIELTE PATTERNANZAHL
02060h            X0031:                EQU       X0030+1        ;BYTE   ;WORK+#36 AKTUELLE PATTERNNUMMER
02060h                                                           ;-------------------------------------------------
02060h                                                           ;AUSZUGEBENDER BLOCK MIT AY3-PROGRAMMIERWERTEN
02060h            X0032:                EQU       X0031+1        ;BYTE   ;WORK+#37 REG. 0=TONHÖHE KANAL A FEIN
02060h                                                           ;BYTE   ;WORK+#38 REG. 1=TONHÖHE KANAL A GROB
02060h            X0033:                EQU       X0032+2        ;BYTE   ;WORK+#39 REG. 2=TONHÖHE KANAL B FEIN
02060h                                                           ;BYTE   ;WORK+#3A REG. 3=TONHÖHE KANAL B GROB
02060h            X0034:                EQU       X0033+2        ;BYTE   ;WORK+#3B REG. 4=TONHÖHE KANAL C FEIN
02060h                                                           ;BYTE   ;WORK+#3C REG. 5=TONHÖHE KANAL C GROB
02060h            X0035:                EQU       X0034+2        ;BYTE   ;WORK+#3D REG. 6=TONHÖHE RAUSCHEN
02060h            X0036:                EQU       X0035+1        ;BYTE   ;WORK+#3E REG. 7=MISCHER             
02060h            X0037:                EQU       X0036+1        ;BYTE   ;WORK+#3F REG. 8=LAUTSTÄRKE KANAL A  
02060h            X0038:                EQU       X0037+1        ;BYTE   ;WORK+#40 REG. 9=LAUTSTÄRKE KANAL B  
02060h            X0039:                EQU       X0038+1        ;BYTE   ;WORK+#41 REG.10=LAUTSTÄRKE KANAL C  
02060h            X0040:                EQU       X0039+1        ;BYTE   ;WORK+#42 REG.11=DAUER HÜLLKURVE FEIN
02060h                                                           ;BYTE   ;WORK+#43 REG.12=DAUER HÜLLKURVE GROB    
02060h            X0041:                EQU       X0040+2        ;BYTE   ;WORK+#44 REG.13=FORM HÜLLKURVE   
02060h            X0042:                EQU       X0041+1        ;WORD   ;WORK+#45 EFFEKT1
02060h            X0043:                EQU       X0042+2        ;BYTE   ;WORK+#47 EFFEKT2
02060h                                                           ;
02060h                                                           ;LETZTE ARBEITSZELLE: WORK+#47 = 00C7 BEI BEGINN AUF 0080
02060h                                                           ;-------------------------------------------------
02060h                                                           ;PROGRAMMANFANG PROG 
02060h                                                           ;-------------------------------------------------
02060h                                                           ;ayinc:  
02060h C39420                           JP        X0048          ;CALL PROG   = SONG LADEN+ABSPIELEN
02063h C37D20                           JP        X0045          ;CALL PROG+3 = GERÄUSCH LADEN+ABSPIELEN
02066h C38220                           JP        X0046          ;CALL PROG+6 = SOUND OFF   
02069h 000000                           DEFS      3,0            ;RESERVE
0206Ch 000000                           DEFS      3,0            ;RESERVE       
0206Fh                                                           ;REGISTERWERTE FUER "ALLES AUS"-------------------
0206Fh 0000000000 X0044:                DEFB      #00,#00,#00,#00,#00,#00,#00
02076h FF00000000                       DEFB      #FF,#00,#00,#00,#00,#00,#01
0207Dh                                                           ;GERÄUSCH LADEN+ABSPIELEN-------------------------
0207Dh 2A1820     X0045:                LD        HL,(X0004)     ;TABELLE REGISTERWERTE
02080h 1807                             JR        X0047
02082h                                                           ;#############################################################        
02082h                                                           ;UP "SOUND STOPPEN"
02082h            X0046:                                         ;CTC-INTERRUPT Kx AUS, GGF ANPASSEN!
02082h 3E43                             LD        A,#43          ;STEUERWORT (INT AUS)
02084h                                  IF        Q358=1         ;K0+K1 KASKADIERT
02084h D33D                             OUT       (CTCBAS+1),A
02086h                                  ELSE                     ;nur KAN. x
02086h                                  OUT       (CTCBAS+CTCCHN),A
02086h                                  ENDIF     
02086h 216F20                           LD        HL,X0044       ;REGISTERWERTE FUER ANHALTEN
02089h                                                           ;##############################################################
02089h 114F20     X0047:                LD        DE,X0032       ;
0208Ch 010E00                           LD        BC,14          ;14 REGISTERWERTE
0208Fh EDB0                             LDIR                     ;UMLADEN
02091h C3FB23                           JP        X0084          ;IN AY3 SCHREIBEN
02094h                                                           ;-------------------------------------------------
02094h                                                           ;SONGDATEN LADEN, CTC PROGRAMMIEREN, STARTEN
02094h F3         X0048:                DI        
02095h 3E0A                             LD        A,#0A
02097h 325D20                           LD        (X0042),A      ;STARTWERT EFFEKT1
0209Ah AF                               XOR       A
0209Bh 325F20                           LD        (X0043),A      ;STARTWERT EFFEKT2 
0209Eh 3D                               DEC       A              ;FF
0209Fh 322C20                           LD        (X0016),A      ;1. ENDE-WERT SETZEN!   
020A2h                                                           ;KOPFDATEN DES LIEDES AUSLESEN------------
020A2h 2A1820                           LD        HL,(X0004)     ;LIEDANFANG
