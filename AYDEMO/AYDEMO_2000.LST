020AAh CDA721                           CALL      X0055          ;HOLEN =>DE
020ADh 1A                               LD        A,(DE)         ;ANZAHL PATTERN IM SONG
020AEh 13                               INC       DE             ;DE=ADR. 1. PATTERNNNUMMER
020AFh 3C                               INC       A              ;+1
020B0h 322520                           LD        (X0012),A      ;ANZAHL PATTERN IM SONG + 1 ABLEGEN
020B3h ED531B20                         LD        (X0006),DE     ;ADRESSE 1. PATTERNNUMMER
020B7h                                            
020B7h CDA721                           CALL      X0055          ;ORNAMENTZEIGER HOLEN
020BAh ED531D20                         LD        (X0007),DE     ;ABLEGEN
020BEh D5                               PUSH      DE             ;MERKEN
020BFh                                            
020BFh CDA721                           CALL      X0055          ;PATTERNZEIGER HOLEN
020C2h ED531F20                         LD        (X0008),DE     ;ABLEGEN
020C6h                                            
020C6h 211B00                           LD        HL,#001B       ;OFFSET 1. SAMPLENUMMER
020C9h CDAC21                           CALL      X0056          ;+LIEDANFANG
020CCh EB                               EX        DE,HL          ;HL=ABSOLUTADRESSE RAM
020CDh 222120                           LD        (X0009),HL     ;ABLEGEN
020D0h                                            
020D0h 212C20                           LD        HL,X0016       ;DORT FF,00
020D3h 222620                           LD        (X0013),HL
020D6h                                            
020D6h 212D20                           LD        HL,X0017       ;BEREICH
020D9h 112E20                           LD        DE,X0017+1
020DCh 012C00                           LD        BC,#002C
020DFh 70                               LD        (HL),B         ;LÖSCHEN
020E0h EDB0                             LDIR      
020E2h                                            
020E2h E1                               POP       HL             ;AB HL=ORNAMENTZEIGER, 
020E3h                                                           ;JEDES ORNAMENT IST 33 BYTES LANG
020E3h 012100                           LD        BC,#0021       ;IN 33ER SCHRITTEN
020E6h AF                               XOR       A              ;00
020E7h CDA221                           CALL      X0054          ;SUCHEN
020EAh 3D                               DEC       A
020EBh 323620                           LD        (X0021),A      ;#FF = ENDE ORNAMENT SETZEN
020EEh 324020                           LD        (X0025),A      ;#FF
020F1h 324A20                           LD        (X0029),A      ;#FF
020F4h 3E01                             LD        A,#01
020F6h 322420                           LD        (X0011),A      ;STARTWERT GLOBAL DELAY WORK
020F9h 23                               INC       HL
020FAh 223420                           LD        (X0020),HL
020FDh 223E20                           LD        (X0024),HL
02100h 224820                           LD        (X0028),HL
02103h CDFB23                           CALL      X0084          ;REGISTER BESCHREIBEN
02106h                                                           ;#########################################
02106h                                                           ;CTC Initialisieren:
02106h                                                           ;als Allererstes den IV eintragen, dann den Rest...
02106h F3                               DI        
02107h 212321                           LD        HL,X0049       ;ADR. PLAYERROUTINE
0210Ah                                                           ;#########################################
0210Ah                                  IF        Q358=1         ;K0+K1 KASKADIERT
0210Ah 221220                           LD        (CTCINT+2),HL  ;ALS INTERRUPT-ADRESSE K1
0210Dh                                  ELSE                     ;nur KAN. x
0210Dh                                  LD        (CTCINT+CTCCHN*2),HL;ALS INTERRUPT-ADRESSE Kx
0210Dh                                  ENDIF     
0210Dh 3E10                             LD        A,LO CTCINT    ;IV
0210Fh D33C                             OUT       (CTCBAS),A     ;K0 --> IV wird immer auf K0 geladen
02111h                                                           ;#########################################
02111h                                  IF        Q358=1         ;K0+K1 KASKADIERT
02111h 3E47                             LD        A,#47          ;STEUERWORT, KEIN INT
02113h D33C                             OUT       (CTCBAS),A     ;K0   
02115h 3E9D                             LD        A,#9D          ;ZK1=157
02117h D33C                             OUT       (CTCBAS),A
02119h 3EC7                             LD        A,#C7          ;STEUERWORT, INT!
0211Bh D33D                             OUT       (CTCBAS+1),A   ;K1
0211Dh 3E39                             LD        A,#39          ;ZK2=57 
0211Fh D33D                             OUT       (CTCBAS+1),A   ;FÜR 3,57954 MHz --> 49,999 Hz
02121h                                  ELSE                     ;nur KAN. x
02121h                                  LD        A,0A7H         ;STEUERWORT, MIT INT, VT 256
02121h                                  OUT       (CTCBAS+CTCCHN),A;Kx  
02121h                                  LD        A,CTCZK        ;ZK an Taktfrequenz anpassen!
02121h                                  OUT       (CTCBAS+CTCCHN),A
02121h                                  ENDIF     
02121h                                                           ;#########################################
02121h FB                               EI                       ;SOUND ON!
02122h C9                               RET       
