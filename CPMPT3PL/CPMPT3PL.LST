00000h                                                           ;-------------------------------------------------
00000h                                                           ;CPMPT3PL
00000h                                                           ;PT3-USB-PLAYER FÜR CP/M
00000h                                                           ;angepasst für den AC1-2010 mit 4MHz CPU-Takt
00000h                                                           ;-------------------------------------------------
00000h                                                           ;WERO, 01/2018
00000h                                                           ;PT3-PLAYER und USB Routinen von WeRo
00000h                                                           ;
00000h                                                           ;BASIS:
00000h                                                           ;VORTEX TRACKER II V1.0 PT3 PLAYER FOR ZX SPECTRUM
00000h                                                           ;(C)2004,2007 S.V.BULBA <VOROBEY@MAIL.KHSTU.RU>
00000h                                                           ;HTTP://BULBA.UNTERGRUND.NET (HTTP://BULBA.AT.KZ)
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.0 
00000h                                                           ;KW 15.02.2018
00000h                                                           ;Anpassung an CP/M
00000h                                                           ;Verwendung CP/M kompatible Rechner über Auswahlmenü
00000h                                                           ;z.B. A5120/K8924 unter CP/A, SCPX
00000h                                                           ;     K8915 unter SCP8915
00000h                                                           ;     NANOS unter EPOS
00000h                                                           ;     LLC2 unter CP/L 
00000h                                                           ;Bildschim-Ausgabe 80x24 und 64x32 möglich
00000h                                                           ;nur BDOS Aufrufe !!!
00000h                                                           ;Parameter (IO-Adressen, IV, ZK) als Patch ausgeführt, da sonst Timingprobleme 
00000h                                                           ; auftreten sind - speziell beim K8915
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Ergänzung mit INI-Datei
00000h                                                           ;Heiko Poppe, 18. Februar 2018
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.3
00000h                                                           ;KW 25.03.2018
00000h                                                           ;Einbindung von Heikos SOUND.INI
00000h                                                           ;USB-Routine aus PT3 Player eingefügt (keine include mehr)
00000h                                                           ;Song vorwärts und rückwärts eingefügt
00000h                                                           ;Loop Funktion eingefügt
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.4
00000h                                                           ;WeRo 27.05.2022
00000h                                                           ;Anpassung für AC1-2010 mit 4 MHz CPU-Takt:
00000h                                                           ;* HL-Registerwert bei der VDIP-Initialisierung
00000h                                                           ;  auf 600h gesetzt
00000h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
00000h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
00000h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
00000h                                                           ;  der Sound-Leiterplatte
00000h                                                           ;* Anpassung für HRCPM12/HRDOS12
00000h                                                           ;  Nutzung der Interrupttabelle auf Adr. 0FF80H
00000h                                                           ;  (bisher nicht verwendeter Interrupt-Einsprung)
00000h                                                           ;------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.5
00000h                                                           ;10.11.2026
00000h                                                           ;Anpassung für AC1-2010 und picoAC1:
00000h                                                           ;* User-Interrupt-Tabelle von 0xFF90 bis 0xFF9F
00000h                                                           ;KW 20.11.2026
00000h                                                           ;* Ausstieg zum OS beim AC1 CPM143 mit RET, sonst evtl. Probleme
00000h                                                           ;* NEU: Zufallswiedergabe der Songs auf dem USB-Stick
00000h                                                           ;  Nach Vorlage vom WeRo (Player für KC87)
00000h                                                           ;  Menue erweitert, MODUS anzeigen
00000h                                                           ;  IM2 nachgetragen... für AC1 notwendig I=FFh  !!!!!
00000h                                                           ;------------------------------------------------
00000h                                            
00000h            AYBAS:                EQU       38H
00000h            CTCBAS:               EQU       AYBAS+4        ;CTC-BASISADRESSE
00000h            CTCKAN:               EQU       0              ;KANAL
00000h            CTCZK:                EQU       156            ;1 BYTE CTC ZK (für 2 MHz) 
00000h            CTCINT:               EQU       0FF90H         ;2 BYTE ADRESSE INTERRUPTTABELLE
00000h            USBPIO:               EQU       0FCH           ;1 BYTE ADRESSE PIO USB-PORT
00000h                                                           ;------------------------------------------------
00000h                                                           ;Q358:      EQU  0            ;nutzt AC1-Systemtakt 2 MHz
00000h                                                           ;höherer CPU-Takt führt zum
00000h                                                           ;schnelleren Abspielen
00000h            Q358:                 EQU       1              ;benutzt Quarz 3,57954 MHz
00000h                                                           ;CTC K0+K1 sind kaskadiert
00000h                                                           ;CPU-Takt ist variabel
00000h                                                           ;------------------------------------------------
00000h            START:                EQU       100H           ;PROGRAMMANFANG
00000h                                                           ;
00000h                                  ORG       START
00100h C3CD0B                           JP        START0
00103h                                                           ;
00103h                                                           ;------------------------------------------------
00103h                                  INCLUDE   PT3PLAY.INC
00103h                                                           ;INCLUDE-DATEI FÜR PT3-PLAYER
00103h                                                           ;-------------------------------------------------
00103h                                                           ;BASIS:
00103h                                                           ;VORTEX TRACKER II V1.0 PT3 PLAYER FOR ZX SPECTRUM
00103h                                                           ;(C)2004,2007 S.V.BULBA <VOROBEY@MAIL.KHSTU.RU>
00103h                                                           ;HTTP://BULBA.UNTERGRUND.NET (HTTP://BULBA.AT.KZ)
00103h            RELEASE:              EQU       "7"            ;RELEASE NUMBER
00103h                                                           ;-------------------------------------------------
00103h                                                           ;MODS:
00103h                                                           ; * EINGEBAUTE INT-ERZEUGUNG PER CTC
00103h                                                           ; * ERSATZ IX DURCH IY WEGEN KC85/X
00103h                                                           ; * AY-ADRESSIERUNG ANGEPASST
00103h                                                           ; * AY-MIXERBITS IMMER BELASSEN!
00103h                                                           ; * POSITIONSZÄHLER EINGEFÜGT 
00103h                                                           ; * PAUSENFLAG EINGEFÜGT
00103h                                                           ; * INT-ZÄHLER EINGEFÜGT (PT3TIME)
00103h                                                           ;-------------------------------------------------
00103h                                                           ;NÖTIGE KONSTANTEN IM HAUPTPROGRAMM:
00103h                                                           ;AYBAS:     BASISADRESSE AY-3-8910
00103h                                                           ;CTCBAS:    BASISADRESSE DER CTC    
00103h                                                           ;CTCKAN:    KANAL DER CTC       
00103h                                                           ;CTCZK:     ZEITKONSTANTE
00103h                                                           ;CTCINT:    ANFANG INTERRUPTTABELLE
00103h                                                           ;Q358:      CTC-Kaskadierung K0+K1
00103h                                                           ;-------------------------------------------------
00103h 3D56544949                       DEFM      "=VTII PT3 Player r.",RELEASE,"=";IDENTIFIER
00118h                                                           ;BEZÜGE-------------------------------------------
00118h                                                           ;CALL   PLAY:   ;INIT CTC + PLAYER
00118h                                                           ;CALL   STOPP:  ;CTC INTERRUPT AUS, TON AUS
00118h                                                           ;CALL   MUTE:   ;NUR TON AUS
00118h                                                           ;-------------------------------------------------
00118h                                                           ;VARIABLEN:
00118h                                                           ;-------------------------------------------------
00118h 0000       MODADR:               DEFW      0              ;ÜBERGABE SONGADRESSE
0011Ah 00         SETUP:                DEFB      0              ;STATUS-RÜCKGABE 
0011Bh                                                           ;SET BIT0 TO 1, IF YOU WANT TO PLAY WITHOUT LOOPING
0011Bh                                                           ;BIT7 IS SET EACH TIME, WHEN LOOP POINT IS PASSED
0011Bh 0000       CRPSPTR:              DEFW      0              ;POINTER TO CURRENT POSITION VALUE IN PT3 MODULE;
0011Dh                                                           ;AFTER INIT (START+11) POINTS TO POSTION0-1
0011Dh 00         POSI:                 DEFB      0              ;POSITION IN MUSTERLISTE
0011Eh 00         PAUSE:                DEFB      0              ;FLAG FÜR PAUSIEREN
0011Fh                                                           ;AYREGS:        ;TABELLENANFANG AUSGABEINHALTE DER 13 AY-REGISTER
0011Fh                                                           ;Z.B. (AYREGS+8) = AMPLITUDE KANAL A
0011Fh                                                           ;-------------------------------------------------
0011Fh                                                           ;AUTO-LOOP
0011Fh 211A01     CHECKLP:              LD        HL,SETUP
00122h CBFE                             SET       7,(HL)         ;ENDEBIT SETZEN
00124h CB46                             BIT       0,(HL)         ;LOOP?
00126h C8                               RET       Z              ;JA
00127h                                                           ;SONGENDE
00127h E1                               POP       HL             ;PLAY VERLASSEN
00128h 214408                           LD        HL,DELYCNT
0012Bh 34                               INC       (HL)
0012Ch 210808                           LD        HL,CHANA+CHP_NTSKCN
0012Fh 34                               INC       (HL)
00130h AF         MUTE:                 XOR       A
00131h 67                               LD        H,A
00132h 6F                               LD        L,A
00133h 329308                           LD        (AYREGS+8),A   ;AMPLA
00136h 229408                           LD        (AYREGS+9),HL  ;AMPLB
00139h C33707                           JP        ROUT_A0        ;AY-REGISTER SETZEN
0013Ch                                                           ;-------------------------------------------------
0013Ch F3         ISR:                  DI        
0013Dh ED734A08                         LD        (SPSV2),SP     ;Stackpointer merken
00141h 318B08                           LD        SP,STACK2      ;lokaler Stack
00144h FDE5                             PUSH      IY
00146h E5                               PUSH      HL
00147h D5                               PUSH      DE
00148h C5                               PUSH      BC
00149h F5                               PUSH      AF
