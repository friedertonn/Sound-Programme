0014Bh F5                               PUSH      AF
0014Ch 3A1E01                           LD        A,(PAUSE)
0014Fh B7                               OR        A
00150h 2003                             JR        NZ,PAUSE1      ;KEIN FORTSCHRITT
00152h CD3606                           CALL      PLAY_Q         ;1 SEGMENT ABSPIELEN
00155h F1         PAUSE1:               POP       AF
00156h 08                               EX        AF,AF'
00157h F1                               POP       AF
00158h C1                               POP       BC
00159h D1                               POP       DE
0015Ah E1                               POP       HL
0015Bh FDE1                             POP       IY
0015Dh ED7B4A08                         LD        SP,(SPSV2)     ;alten Stackpointer zurückholen
00161h FB                               EI        
00162h                                                           ;ERST HIER FREIGEBEN, PLAYER MANIPULIERT STACK!!!!
00162h ED4D                             RETI      
00164h                                                           ;-------------------------------------------------        
00164h            STOPP:                                         ;SONG ANHANLTEN, INTERRUPT STOPPEN
00164h                                                           ;REGISTERWERTE FUER "ALLES AUS
00164h F3                               DI        
00165h 3E43                             LD        A,#43          ;STEUERWORT (INT AUS)
00167h                                  IF        Q358=1         ;K0+K1 KASKADIERT
00167h D33D                             OUT       (CTCBAS+1),A
00169h                                  ELSE                     ;nur KAN. x
00169h                                  OUT       (CTCBAS+CTCKAN),A
00169h                                  ENDIF     
00169h 217901     STOPP1:               LD        HL,STOPP2      ;REGISTERWERTE FUER ANHALTEN
0016Ch 118B08                           LD        DE,AYREGS      ;TABELLE AUSGABE-WERTE
0016Fh 010E00                           LD        BC,14          ;14 REGISTERWERTE
00172h EDB0                             LDIR                     ;UMLADEN        
00174h CD3607                           CALL      ROUT           ;IN AY3 SCHREIBEN
00177h FB                               EI        
00178h C9                               RET       
00179h 0000000000 STOPP2:               DEFB      0,0,0,0,0,0,0,0FFH,0,0,0,0,0,0
00187h                                                           ;-------------------------------------------------
00187h                                                           ;ABSPIEL STARTEN
00187h            PLAY:                                          ;(1)Arbeitszellen löschen-----------------
00187h 21ED07                           LD        HL,VARS
0018Ah 3600                             LD        (HL),0
0018Ch 11EE07                           LD        DE,VARS+1
0018Fh 01AD00                           LD        BC,VAR0END-1-VARS
00192h EDB0                             LDIR      
00194h                                                           ;(2) CTC INITIALISIEREN-------------------
00194h F3                               DI        
00195h 213C01                           LD        HL,ISR         ;ADR. PLAYERROUTINE
00198h                                                           ;#################################################
00198h                                  IF        Q358=1         ;K0+K1 KASKADIERT
00198h 2292FF                           LD        (CTCINT+2),HL  ;ALS INTERRUPT-ADRESSE K1
0019Bh                                  ELSE                     ;nur KAN. x
0019Bh                                  LD        (CTCINT+CTCKAN*2),HL;ALS INTERRUPT-ADRESSE Kx
0019Bh                                  ENDIF     
0019Bh 3E90                             LD        A,LO CTCINT    ;IV (01)C8
0019Dh D33C                             OUT       (CTCBAS),A     ;K0
0019Fh                                                           ;#################################################
0019Fh                                  IF        Q358=1         ;K0+K1 KASKADIERT
0019Fh 3E47                             LD        A,#47          ;STEUERWORT, KEIN INT
001A1h D33C                             OUT       (CTCBAS),A     ;K0   
001A3h 3E9D                             LD        A,#9D          ;ZK1=157
001A5h D33C                             OUT       (CTCBAS),A
001A7h 3EC7                             LD        A,#C7          ;STEUERWORT, INT!
001A9h D33D                             OUT       (CTCBAS+1),A   ;K1
001ABh 3E39                             LD        A,#39          ;ZK2=57 
001ADh D33D                             OUT       (CTCBAS+1),A   ;FÜR 3,57954 MHz --> 49,999 Hz
001AFh                                  ELSE                     ;nur KAN. x
001AFh                                  LD        A,0A7H         ;STEUERWORT, MIT INT, VT 256
001AFh                                  OUT       (CTCBAS+CTCKAN),A;Kx  
001AFh                                  LD        A,CTCZK        ;ZK JE NACH TAKTFREQUENZ
001AFh                                  OUT       (CTCBAS+CTCKAN),A
001AFh                                  ENDIF     
001AFh                                                           ;#################################################
001AFh FB                               EI        
001B0h                                                           ;(3) PLAYER INITIALISIEREN----------------
001B0h AF                               XOR       A
