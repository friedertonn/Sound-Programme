00000h                                                           ;------------------------------------------------
00000h                                                           ;CPMSTCPL
00000h                                                           ;STC-USB-PLAYER FÜR CP/M 
00000h                                                           ;angepasst für den AC1-2010 mit 4MHz CPU-Takt
00000h                                                           ;-------------------------------------------------
00000h                                                           ;WERO, 12/2017
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.2 
00000h                                                           ;KW 03.02.2018
00000h                                                           ;Verwendung CP/M kompatible Rechner über Auswahlmenü
00000h                                                           ;z.B.A5120/K8924 unter CP/A, SCPX
00000h                                                           ;    K8915 unter SCP8915
00000h                                                           ;    NANOS unter EPOS
00000h                                                           ;    LLC2 unter CP/L 
00000h                                                           ;Bildschim-Ausgabe 80x24 und 64x32 möglich
00000h                                                           ;nur BDOS Aufrufe !!!
00000h                                                           ;Parameter (IO-Adressen, IV, ZK) als Patch, da sonst Timingprobleme 
00000h                                                           ; aufgetreten sind --- speziell beim K8915
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Ergänzung mit INI-Datei 
00000h                                                           ;Heiko Poppe, 18. Februar 2018
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.3
00000h                                                           ;KW 25.03.2018
00000h                                                           ;Einbindung von Heikos SOUND.INI
00000h                                                           ;USB-Routine aus PT3 Player eingefügt (keine include mehr)
00000h                                                           ;Song vorwärts und rückwärts einegfügt
00000h                                                           ;Loop Funktion eingefügt
00000h                                                           ;-------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.4
00000h                                                           ;27.05.2022
00000h                                                           ;Anpassung für AC1-2010 mit 4 MHz CPU-Takt:
00000h                                                           ;* HL-Registerwert bei der VDIP-Initialisierung
00000h                                                           ;  auf 600h gesetzt
00000h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
00000h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
00000h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
00000h                                                           ;  der Sound-Leiterplatte
00000h                                                           ;* Anpassung für HRCPM12/HRDOS12
00000h                                                           ;  Nutzung der Interrupttabelle auf Adr. 0FF80H
00000h                                                           ;  (bisher nicht verwendeter Interrupt-Einsprung)
00000h                                                           ;------------------------------------------------
00000h                                            
00000h                                                           ;Version 1.0.5
00000h                                                           ;10.11.2026
00000h                                                           ;Anpassung für AC1-2010 und picoAC1:
00000h                                                           ;* User-Interrupt-Tabelle von 0xFF90 bis 0xFF9F
00000h                                                           ;------------------------------------------------
00000h                                            
00000h            AYBAS:                EQU       38H
00000h            CTCBAS:               EQU       AYBAS+4        ;CTC-BASISADRESSE
00000h            CTCCHN:               EQU       0              ;CTC-KANAL
00000h            CTCZK:                EQU       156            ;1 BYTE CTC ZK (für 2 MHz) 
00000h            CTCINT:               EQU       0FF90H         ;2 BYTE ADRESSE INTERRUPTTABELLE
00000h            USBPIO:               EQU       0FCH           ;1 BYTE ADRESSE PIO USB-PORT
00000h                                                           ;------------------------------------------------
00000h                                                           ;Q358:      EQU  0            ;nutzt AC1-Systemtakt 2 MHz
00000h                                                           ;höherer CPU-Takt führt zum
00000h                                                           ;schnelleren Abspielen
00000h            Q358:                 EQU       1              ;benutzt Quarz 3,57954 MHz
00000h                                                           ;CTC K0+K1 sind kaskadiert
00000h                                                           ;CPU-Takt ist variabel
00000h                                                           ;------------------------------------------------
00000h            START:                EQU       100H           ;PROGRAMMANFANG
00000h            WORK:                 EQU       START+10H      ;BEGINN ARBEITSZELLEN
00000h                                                           ;-------------------------------------------------
00000h                                                           ;PROGRAMMSTART
00000h                                  ORG       START
00100h C31A07                           JP        START0
00103h                                                           ;-------------------------------------------------
00103h 0000000000                       ORG       WORK           ;ARBEITSZELLEN
00110h 0000000000                       DEFS      256            ;128         
00210h                                                           ;PLAYER-BEZÜGE
00210h                                                           ;WORK...WORK+71 ;RESERVIERT FÜR STC-PLAYER
00210h            SNGADR:               EQU       WORK           ;WORD, ANFANGSADRESSE SONG
00210h            WDH:                  EQU       WORK+02        ;BYTE, ANZAHL WIEDERHOLUNGEN
00210h            MAXI:                 EQU       WORK+0DH       ;BYTE, ANZAHL PATTERN IM SONG
00210h            POSI:                 EQU       WORK+35H       ;BYTE, ABGESPIELTE PATTERNANZAHL
00210h            LAUT_A:               EQU       WORK+3FH       ;BYTE, REG. 8=LAUTSTÄRKE KANAL A
00210h            LAUT_B:               EQU       WORK+40H       ;BYTE, REG. 9=LAUTSTÄRKE KANAL B
00210h            LAUT_C:               EQU       WORK+41H       ;BYTE, REG.10=LAUTSTÄRKE KANAL
00210h                                                           ;-------------------------------------------------
00210h            PLAYER:                                        ;AY-PLAYER-ENGINE
00210h                                  INCLUDE   AYPLAC1.INC
00210h                                                           ;#################################################
00210h                                                           ;INCLUDE-FILE "PLAYER-ENGINE"
00210h                                                           ;FÜR STC-PLAYER MIT AY-3-8910 
00210h                                                           ;Version für AC1-2010 mit 4 MHz CPU-Takt
00210h                                                           ;#################################################
00210h                                                           ;-------------------------------------------------
00210h                                                           ;ORIGINAL-VERÖFFENTLICHUNGEN:
00210h                                                           ;"MUSIK-TÜRKLINGEL MIT DEM AUDIO-COPROZESSOR AY8910"
00210h                                                           ;MAGAZIN 'RADIO', 1998/6, S. 42 + 43 (RUSSISCH)
00210h                                                           ;http://www.radioman-portal.ru/magazin/radio/1998/6.php
00210h                                                           ;
00210h                                                           ;ABSPIELROUTINE FÜR ZX81 MIT AY-3-8910-ADAPTER
00210h                                                           ;http://www.sinclairzxworld.com/viewtopic.php?t=528&start=100
00210h                                                           ;-------------------------------------------------
00210h                                                           ;PRINZIP CTC-TEIL: ENTWICKLERTEAM "M066"
00210h                                                           ;BEARBEITUNG, INCLUDE UND DOKU: WERO 10/2017
00210h                                                           ;ASSEMBLER: ASIDE
00210h                                                           ;-------------------------------------------------
00210h                                                           ;VERSION 1.1:
00210h                                                           ;* ISR GEÄNDERT
00210h                                                           ;* ARBEITSZELLEN STC-PLAYER VOR START GELÖSCHT
00210h                                                           ;* MISCHERBITS PORTREGISTER: BEI SONG-START/ENDE AUF EINGABE
00210h                                                           ;-------------------------------------------------
00210h                                                           ;VERSION 1.2:
00210h                                                           ;* MISCHERBITS PORTREGISTER: BLEIBEN IMMER UNANGETASTET
00210h                                                           ;Version 1.2.13
00210h                                                           ;KW 19.11.2017 (Klaus Wilfling)
00210h                                                           ;Anpassungen an K1520-SOUND-Karte 
00210h                                                           ;Bastelsystem mit ZRE K2526 unter CP/A, SCPX 
00210h                                                           ;SOUND-CTC Interruptsäule-F7D8h I=F7h, IV=D8h
00210h                                                           ;IO-Adresse der SOUND-Karte = 38h
00210h                                                           ;SOUND-Karten CTC Kanal 0 als 20ms Zeitgeber
00210h                                                           ;Version 1.2.14
00210h                                                           ;KW 03.02.2018
00210h                                                           ;Anpassung an unterschiedliche Rechnersysteme unter CP/M Klone
00210h                                                           ;Anpasssung wegen Problemen mit K8915 unter SCP8915
00210h                                                           ;zusätzlicher Stack für Interruptroutine für SCPX empfohlen
00210h                                                           ;-------------------------------------------------
00210h                                                           ;VERSION 1.3:
00210h                                                           ;Anpassung für AC1-2010 mit 4 MHz CPU-Takt (05/2022):
00210h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
00210h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
00210h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
00210h                                                           ;  der Sound-Leiterplatte
00210h                                                           ;* Änderungen in der ISR-Routine bei der Int.-Annahme
00210h                                                           ;-------------------------------------------------
00210h                                                           ;ANFORDERUNGEN AN HAUPTPROGRAMM:
00210h                                                           ;* DARF LABELS X0001...X0087 NICHT BENUTZEN
00210h                                                           ;* MUSS ARBEITSZELLENBEGINN MIT LABEL 'WORK' DEFINIEREN!
00210h                                                           ;* MUSS FOLGENDE KONSTANTEN BEREITSTELLEN:
00210h                                                           ;CTCBAS: EQU     0                  ;CTC-Basisadresse
00210h                                                           ;CTCCHN: EQU     3                  ;CTC-Kanal
00210h                                                           ;CTCZK:  EQU     9Ch                ;CTC-Zeitkonstante
00210h                                                           ;CTCINT: EQU     PROGR+10h          ;LAGE Interrupttabelle CTC
00210h                                                           ;                         (8er Schritte, I-Register beachten!)
00210h                                                           ;Q358:   EQU     1                  ;CTC-Kaskadierung K0+K1
00210h                                                           ;-------------------------------------------------
00210h                                                           ;SOFERN 38H NICHT GEEIGNET, MUSS BASISADRESSE HIER ANGEPASST WERDEN:
00210h            X0001:                EQU       #38            ;AY-BASISADRESSE  (K1520-SOUND)
00210h                                                           ;-------------------------------------------------
00210h                                                           ;PLAYER-AREBEITSZELLEN AB WORK
00210h            X0004:                EQU       WORK           ;WORD   ;WORK     ABLAGE LIEDANFANG   
00210h            X0005:                EQU       X0004+2        ;BYTE   ;WORK+#02 ABLAGE ANZAHL SONG-WIEDERHOLUNGEN 
00210h            X0006:                EQU       X0005+1        ;WORD   ;WORK+#03 POSITIONS-ZEIGER
00210h            X0007:                EQU       X0006+2        ;WORD   ;WORK+#05 ORNAMENT-ZEIGER      
00210h            X0008:                EQU       X0007+2        ;WORD   ;WORK+#07 PATTERN-ZEIGER       
00210h            X0009:                EQU       X0008+2        ;WORD   ;WORK+#09 POINTER 1. SAMPLE NR       
00210h            X0010:                EQU       X0009+2        ;BYTE   ;WORK+#0B GLOBAL DELAY SONG  
00210h            X0011:                EQU       X0010+1        ;BYTE   ;WORK+#0C GLOBAL DELAY WORK
00210h            X0012:                EQU       X0011+1        ;BYTE   ;WORK+#0D ANZAHL  PATTERN IM SONG 
00210h            X0013:                EQU       X0012+1        ;WORD   ;WORK+#0E ADRESSE PATTERN KANAL A 
00210h            X0014:                EQU       X0013+2        ;WORD   ;WORK+#10 ADRESSE PATTERN KANAL B
00210h            X0015:                EQU       X0014+2        ;WORD   ;WORK+#12 ADRESSE PATTERN KANAL C
00210h            X0016:                EQU       X0015+2        ;BYTE   ;WORK+#14 ENDEMARKE (FF)
00210h            X0017:                EQU       X0016+1        ;WORD   ;WORK+#15
00210h                                                           ;KANAL A------------------------------------------
00210h            X0018:                EQU       X0017+2        ;BYTE   ;WORK+#17 INDEX A
00210h                                                           ;BYTE   ;WORK+#18 NOTENNNUMMER
00210h                                                           ;BYTE   ;WORK+#19 PAUSE ZWISCHEN NOTEN
00210h            X0019:                EQU       X0018+3        ;WORD   ;WORK+#1A SAMPLEADRESSE
00210h            X0020:                EQU       X0019+2        ;WORD   ;WORK+#1C ORNAMENTADRESSE
00210h            X0021:                EQU       X0020+2        ;3XBYTE ;WORK+#1E 
00210h                                                           ;KANAL B------------------------------------------
00210h            X0022:                EQU       X0021+3        ;BYTE   ;WORK+#21 INDEX B
00210h                                                           ;BYTE   ;WORK+#22 NOTENNNUMMER
00210h                                                           ;BYTE   ;WORK+#23 PAUSE ZWISCHEN NOTEN
00210h            X0023:                EQU       X0022+3        ;WORD   ;WORK+#24 SAMPLEADRESSE
00210h            X0024:                EQU       X0023+2        ;WORD   ;WORK+#26 ORNAMENTADRESSE
00210h            X0025:                EQU       X0024+2        ;3XBYTE ;WORK+#28
00210h                                                           ;KANAL C------------------------------------------
00210h            X0026:                EQU       X0025+3        ;BYTE   ;WORK+#2B INDEX C
00210h                                                           ;BYTE   ;WORK+#2C NOTENNNUMMER
00210h                                                           ;BYTE   ;WORK+#2D PAUSE ZWISCHEN NOTEN
00210h            X0027:                EQU       X0026+3        ;WORD   ;WORK+#2E SAMPLEADRESSE
00210h            X0028:                EQU       X0027+2        ;WORD   ;WORK+#30 ORNAMENTADRESSE
00210h            X0029:                EQU       X0028+2        ;3XBYTE ;WORK+#32
00210h                                                           ;-------------------------------------------------
00210h            X0030:                EQU       X0029+3        ;BYTE   ;WORK+#35 ABGESPIELTE PATTERNANZAHL
00210h            X0031:                EQU       X0030+1        ;BYTE   ;WORK+#36 AKTUELLE PATTERNNUMMER
00210h                                                           ;-------------------------------------------------
00210h                                                           ;AUSZUGEBENDER BLOCK MIT AY3-PROGRAMMIERWERTEN
00210h            X0032:                EQU       X0031+1        ;BYTE   ;WORK+#37 REG. 0=TONHÖHE KANAL A FEIN
00210h                                                           ;BYTE   ;WORK+#38 REG. 1=TONHÖHE KANAL A GROB
00210h            X0033:                EQU       X0032+2        ;BYTE   ;WORK+#39 REG. 2=TONHÖHE KANAL B FEIN
00210h                                                           ;BYTE   ;WORK+#3A REG. 3=TONHÖHE KANAL B GROB
00210h            X0034:                EQU       X0033+2        ;BYTE   ;WORK+#3B REG. 4=TONHÖHE KANAL C FEIN
00210h                                                           ;BYTE   ;WORK+#3C REG. 5=TONHÖHE KANAL C GROB
00210h            X0035:                EQU       X0034+2        ;BYTE   ;WORK+#3D REG. 6=TONHÖHE RAUSCHEN
00210h            X0036:                EQU       X0035+1        ;BYTE   ;WORK+#3E REG. 7=MISCHER             
00210h            X0037:                EQU       X0036+1        ;BYTE   ;WORK+#3F REG. 8=LAUTSTÄRKE KANAL A  
00210h            X0038:                EQU       X0037+1        ;BYTE   ;WORK+#40 REG. 9=LAUTSTÄRKE KANAL B  
00210h            X0039:                EQU       X0038+1        ;BYTE   ;WORK+#41 REG.10=LAUTSTÄRKE KANAL C  
00210h            X0040:                EQU       X0039+1        ;BYTE   ;WORK+#42 REG.11=DAUER HÜLLKURVE FEIN
00210h                                                           ;BYTE   ;WORK+#43 REG.12=DAUER HÜLLKURVE GROB    
00210h            X0041:                EQU       X0040+2        ;BYTE   ;WORK+#44 REG.13=FORM HÜLLKURVE   
00210h            X0042:                EQU       X0041+1        ;WORD   ;WORK+#45 EFFEKT1
00210h            X0043:                EQU       X0042+2        ;BYTE   ;WORK+#47 EFFEKT2
00210h                                                           ;
00210h                                                           ;LETZTE ARBEITSZELLE: WORK+#47 = 00C7 BEI BEGINN AUF 0080
00210h                                                           ;-------------------------------------------------
00210h                                                           ;PROGRAMMANFANG PROG 
00210h                                                           ;-------------------------------------------------
00210h                                                           ;ayinc:  
00210h C34402                           JP        X0048          ;CALL PROG   = SONG LADEN+ABSPIELEN
00213h C32D02                           JP        X0045          ;CALL PROG+3 = GERÄUSCH LADEN+ABSPIELEN
00216h C33202                           JP        X0046          ;CALL PROG+6 = SOUND OFF   
00219h 000000                           DEFS      3,0            ;RESERVE
0021Ch 000000                           DEFS      3,0            ;RESERVE       
0021Fh                                                           ;REGISTERWERTE FUER "ALLES AUS"-------------------
0021Fh 0000000000 X0044:                DEFB      #00,#00,#00,#00,#00,#00,#00
00226h FF00000000                       DEFB      #FF,#00,#00,#00,#00,#00,#01
0022Dh                                                           ;GERÄUSCH LADEN+ABSPIELEN-------------------------
0022Dh 2A1001     X0045:                LD        HL,(X0004)     ;TABELLE REGISTERWERTE
00230h 1807                             JR        X0047
00232h                                                           ;#############################################################        
00232h                                                           ;UP "SOUND STOPPEN"
00232h            X0046:                                         ;CTC-INTERRUPT Kx AUS, GGF ANPASSEN!
00232h 3E43                             LD        A,#43          ;STEUERWORT (INT AUS)
00234h                                  IF        Q358=1         ;K0+K1 KASKADIERT
00234h D33D                             OUT       (CTCBAS+1),A
00236h                                  ELSE                     ;nur KAN. x
00236h                                  OUT       (CTCBAS+CTCCHN),A
00236h                                  ENDIF     
00236h 211F02                           LD        HL,X0044       ;REGISTERWERTE FUER ANHALTEN
00239h                                                           ;##############################################################
00239h 114701     X0047:                LD        DE,X0032       ;
0023Ch 010E00                           LD        BC,14          ;14 REGISTERWERTE
0023Fh EDB0                             LDIR                     ;UMLADEN
00241h C3AB05                           JP        X0084          ;IN AY3 SCHREIBEN
00244h                                                           ;-------------------------------------------------
00244h                                                           ;SONGDATEN LADEN, CTC PROGRAMMIEREN, STARTEN
00244h F3         X0048:                DI        
00245h 3E0A                             LD        A,#0A
00247h 325501                           LD        (X0042),A      ;STARTWERT EFFEKT1
0024Ah AF                               XOR       A
0024Bh 325701                           LD        (X0043),A      ;STARTWERT EFFEKT2 
0024Eh 3D                               DEC       A              ;FF
0024Fh 322401                           LD        (X0016),A      ;1. ENDE-WERT SETZEN!   
00252h                                                           ;KOPFDATEN DES LIEDES AUSLESEN------------
00252h 2A1001                           LD        HL,(X0004)     ;LIEDANFANG
00255h 7E                               LD        A,(HL)         ;1. ZEICHEN = "GLOBAL DELAY"
00256h 321B01                           LD        (X0010),A      ;ABLEGEN
00259h 23                               INC       HL             ;POSITIONSZEIGER
0025Ah CD5703                           CALL      X0055          ;HOLEN =>DE
0025Dh 1A                               LD        A,(DE)         ;ANZAHL PATTERN IM SONG
0025Eh 13                               INC       DE             ;DE=ADR. 1. PATTERNNNUMMER
0025Fh 3C                               INC       A              ;+1
00260h 321D01                           LD        (X0012),A      ;ANZAHL PATTERN IM SONG + 1 ABLEGEN
00263h ED531301                         LD        (X0006),DE     ;ADRESSE 1. PATTERNNUMMER
00267h                                            
00267h CD5703                           CALL      X0055          ;ORNAMENTZEIGER HOLEN
0026Ah ED531501                         LD        (X0007),DE     ;ABLEGEN
0026Eh D5                               PUSH      DE             ;MERKEN
0026Fh                                            
0026Fh CD5703                           CALL      X0055          ;PATTERNZEIGER HOLEN
00272h ED531701                         LD        (X0008),DE     ;ABLEGEN
00276h                                            
00276h 211B00                           LD        HL,#001B       ;OFFSET 1. SAMPLENUMMER
00279h CD5C03                           CALL      X0056          ;+LIEDANFANG
0027Ch EB                               EX        DE,HL          ;HL=ABSOLUTADRESSE RAM
0027Dh 221901                           LD        (X0009),HL     ;ABLEGEN
00280h                                            
00280h 212401                           LD        HL,X0016       ;DORT FF,00
00283h 221E01                           LD        (X0013),HL
00286h                                            
00286h 212501                           LD        HL,X0017       ;BEREICH
00289h 112601                           LD        DE,X0017+1
0028Ch 012C00                           LD        BC,#002C
0028Fh 70                               LD        (HL),B         ;LÖSCHEN
00290h EDB0                             LDIR      
00292h                                            
00292h E1                               POP       HL             ;AB HL=ORNAMENTZEIGER, 
00293h                                                           ;JEDES ORNAMENT IST 33 BYTES LANG
00293h 012100                           LD        BC,#0021       ;IN 33ER SCHRITTEN
00296h AF                               XOR       A              ;00
00297h CD5203                           CALL      X0054          ;SUCHEN
0029Ah 3D                               DEC       A
0029Bh 322E01                           LD        (X0021),A      ;#FF = ENDE ORNAMENT SETZEN
0029Eh 323801                           LD        (X0025),A      ;#FF
002A1h 324201                           LD        (X0029),A      ;#FF
002A4h 3E01                             LD        A,#01
002A6h 321C01                           LD        (X0011),A      ;STARTWERT GLOBAL DELAY WORK
002A9h 23                               INC       HL
002AAh 222C01                           LD        (X0020),HL
002ADh 223601                           LD        (X0024),HL
002B0h 224001                           LD        (X0028),HL
002B3h CDAB05                           CALL      X0084          ;REGISTER BESCHREIBEN
002B6h                                                           ;#########################################
002B6h                                                           ;CTC Initialisieren:
002B6h                                                           ;als Allererstes den IV eintragen, dann den Rest...
002B6h F3                               DI        
002B7h 21D302                           LD        HL,X0049       ;ADR. PLAYERROUTINE
002BAh                                                           ;#########################################
002BAh                                  IF        Q358=1         ;K0+K1 KASKADIERT
002BAh 2292FF                           LD        (CTCINT+2),HL  ;ALS INTERRUPT-ADRESSE K1
002BDh                                  ELSE                     ;nur KAN. x
002BDh                                  LD        (CTCINT+CTCCHN*2),HL;ALS INTERRUPT-ADRESSE Kx
002BDh                                  ENDIF     
002BDh 3E90                             LD        A,LO CTCINT    ;IV
002BFh D33C                             OUT       (CTCBAS),A     ;K0 --> IV wird immer auf K0 geladen
002C1h                                                           ;#########################################
002C1h                                  IF        Q358=1         ;K0+K1 KASKADIERT
002C1h 3E47                             LD        A,#47          ;STEUERWORT, KEIN INT
002C3h D33C                             OUT       (CTCBAS),A     ;K0   
002C5h 3E9D                             LD        A,#9D          ;ZK1=157
002C7h D33C                             OUT       (CTCBAS),A
002C9h 3EC7                             LD        A,#C7          ;STEUERWORT, INT!
002CBh D33D                             OUT       (CTCBAS+1),A   ;K1
002CDh 3E39                             LD        A,#39          ;ZK2=57 
002CFh D33D                             OUT       (CTCBAS+1),A   ;FÜR 3,57954 MHz --> 49,999 Hz
002D1h                                  ELSE                     ;nur KAN. x
002D1h                                  LD        A,0A7H         ;STEUERWORT, MIT INT, VT 256
002D1h                                  OUT       (CTCBAS+CTCCHN),A;Kx  
002D1h                                  LD        A,CTCZK        ;ZK an Taktfrequenz anpassen!
002D1h                                  OUT       (CTCBAS+CTCCHN),A
002D1h                                  ENDIF     
002D1h                                                           ;#########################################
002D1h FB                               EI                       ;SOUND ON!
002D2h C9                               RET       
002D3h                                                           ;-------------------------------------------------
002D3h                                                           ;ROUTINE WIRD ALLER 1/50 SEKUNDEN AUFGERUFEN UND 
002D3h                                                           ;VERANLASST 1 PROGRAMMIERUNG DES AY-3-8910 
002D3h F3         X0049:                DI        
002D4h ED739606                         LD        (SPSV2),SP     ;Stackpointer merken
002D8h 31D706                           LD        SP,STACK2      ;lokaler Stack
002DBh FDE5                             PUSH      IY
002DDh E5                               PUSH      HL
002DEh D5                               PUSH      DE
002DFh C5                               PUSH      BC
002E0h F5                               PUSH      AF
002E1h 08                               EX        AF,AF'
002E2h F5                               PUSH      AF
002E3h CDFE02                           CALL      X0051          ;1x AY PROGRAMMIEREN
002E6h 3A1201                           LD        A,(X0005)      ;WIEDERHOLUNG SONG?
002E9h B7                               OR        A              ;FERTIG?
002EAh 2003                             JR        NZ,X0050       ;NEIN
002ECh CD3202                           CALL      X0046          ;JA: CTC-INTERRUPT AUS!
002EFh F1         X0050:                POP       AF
002F0h 08                               EX        AF,AF'
002F1h F1                               POP       AF
002F2h C1                               POP       BC
002F3h D1                               POP       DE
002F4h E1                               POP       HL
002F5h FDE1                             POP       IY
002F7h ED7B9606                         LD        SP,(SPSV2)     ;alten Stackpointer zurückholen
002FBh FB                               EI        
002FCh ED4D                             RETI      
002FEh                                                           ;-----------------------------------------------------
002FEh 3A1C01     X0051:                LD        A,(X0011)      ;GLOBAL DELAY WORK (IN INTERRUPTS)
00301h 3D                               DEC       A              ;VERRINGERN
00302h 321C01                           LD        (X0011),A      ;ABLEGEN
00305h C2D804                           JP        NZ,X0078       ;ARBEITSBEREICH FÜLLEN
00308h                                            
00308h 3A1B01                           LD        A,(X0010)      ;GLOBAL DELAY
0030Bh 321C01                           LD        (X0011),A      ;WORK NEU LADEN
0030Eh                                            
0030Eh FD212701                         LD        IY,X0018       ;INDEX KANAL A
00312h CDE303                           CALL      X0062          ;TEST, OB ETWAS AUSZUGEBEN
00315h F22903                           JP        P,X0052        ;NEIN!
00318h                                            
00318h                                                           ;KANAL A VERARBEITEN----------------------
00318h 2A1E01                           LD        HL,(X0013)     ;ADRESSE PATTERN KANAL A
0031Bh 7E                               LD        A,(HL)
0031Ch 3C                               INC       A              ;WAR FF? (ENDE PATTERN)
