; ***************************************************
; *                                                 *
; *  CTC-Testprogramm       Version vom 18.11.2026  *
; *  ================               von Frieder     *
; *                                                 *
; ***************************************************
;
; Kurz-Dokumentation:
; - 4 Tests der Interruptfunktion der CTC
; - Kanal 0 und 1 der CTC sind verbunden
; - Interrupt alle 20 Millisekunden
; - funktioniert mit dem AC1-Monitor und unter CP/M
;
; Assemblieren des Quelltextes unter CP/M:
; M80 = CTCTEST
; LINKMT CTCTEST
;
; ***************************************************
; *  Wichtig: Fuer das AC1-Programm muss die        *
; *           folgende Zeile auskommentiert werden  *
; ***************************************************
CPM     EQU  1            ;CP/M-Version
;
        PAGE 64
        IF1
        IFDEF CPM
        .PRINTX 'CP/M-Version'
        ELSE
        .PRINTX 'Version fuer den AC1-Monitor'
        ENDIF
        .PRINTX 'PASS 1'
        ENDIF
;
        IF2
        .PRINTX 'PASS 2'
        ENDIF
;
        .CREF
        .Z80
        IFDEF CPM
        .PHASE 100H       ;CP/M-Programm startet bei 100H
        ELSE
        .PHASE 2000H      ;AC1-Programm startet bei 2000H
        ENDIF
;
WBOOT   EQU  00000H       ;Warmstart
CONST   EQU  0E606H       ;BIOS - CONST
CONIN   EQU  0E609H       ;BIOS - CONIN
CONOUT  EQU  0E60CH       ;BIOS - CONOUT
;
GETCO   EQU  07FDH        ;AC1-Monitor - Eingabeschleife
;
        JP   START
        DEFS 5,0
;
;
; Interruptvektoren-Tabelle
;
        IFDEF CPM
IV      EQU  0FF90H       ;USER-Interruptvektoren
        ELSE
IV:     DEFS 8,0          ;im AC1-Monitor Adr. 2008H
        ENDIF
;
; UP Taste gedrueckt?
; ===================
;
TASTE:
        IFDEF CPM
PATCH1: CALL CONST        ;CP/M: CONST
        ELSE
        IN   A,(04H)      ;AC1: PIO1 Port A lesen
        RES  7,A
        OR   A
        JR   Z,TASTE1
        LD   A,0FFH       ;Taste gedrueckt
        ENDIF
TASTE1: RET
;
; UP Zeicheneingabe
; =================
;
INZEI:
        IFDEF CPM
PATCH2: CALL CONIN        ;CP/M: CONIN
        ELSE
INZEI1: IN   A,(04H)      ;AC1: PIO1 Port A lesen
        RES  7,A
        OR   A
        JR   NZ,INZEI1    ;(falsche) Taste gedrueckt
INZEI2: IN   A,(04H)      ;AC1: PIO1 Port A lesen
        RES  7,A
        OR   A
        JR   Z,INZEI2     ;keine Taste gedrueckt
        ENDIF
        RET
;
; UP Zeichenausgabe
; =================
;
OUTZEI: PUSH AF
        PUSH BC
        PUSH DE           ;wg. CONOUT im HRCPM12!
        IFDEF CPM
PATCH3: CALL CONOUT       ;CP/M: CONOUT
        ELSE
        LD  A,C
        CP  0AH           ;AC1: 0AH nicht ausgeben
        JR  Z,OUTZE1
        RST 10H           ;AC1: RST 10H
        ENDIF
OUTZE1: POP  DE
        POP  BC
        POP  AF
        RET
;
; UP Textausgabe
; ==============
;
OUTTXT: PUSH AF
        PUSH BC
        PUSH DE           ;wg. CONOUT im HRCPM12!
OUTTX1: LD   A,(HL)
        CP   0            ;Ende
        JR   Z,OUTTX3
        IFDEF CPM
        LD   C,A
PATCH4: CALL CONOUT       ;CP/M: CONOUT
        ELSE
        CP  0AH           ;0AH nicht ausgeben
        JR  Z,OUTTX2
        RST 10H           ;AC1: RST 10H
        ENDIF
OUTTX2: INC  HL
        JR   OUTTX1
OUTTX3: POP  DE
        POP  BC
        POP  AF
        RET
;
; UP Eingabe einer HEX-Ziffer
; ===========================
;
INHEX:  CALL INZEI        ;Zeicheneingabe --> A
        LD   C,A
        CP   '0'          ;kleiner als "0"?
        JR   C,INHEX
        CP   '9'+1        ;kleiner als "9"?
        JR   C,INHEXE
        AND  5FH          ;Kleinbuchstaben --> Grossb.
        CP   'A'          ;kleiner als "A"?
        JR   C,INHEX
        CP   'F'+1        ;groesser als "F"?
        JR   NC,INHEX
        LD   C,A          ;ASCII-Zeichen steht in C
        SUB  7
INHEXE: SUB  '0'          ;HEX-Code steht in A
        RET
;
; Bildschirmausschriften
; ======================
;
ANFTXT: DEFB 0DH,0AH,0DH,0AH
        DEFM "CTC-Testprogramm"
        DEFB 0DH,0AH
        DEFM "----------------"
        DEFB 0DH,0AH,0DH,0AH
        DEFM "* Test der Interruptfunktion der CTC Kanal 0"
        DEFB 0DH,0AH
        DEFM "* Test der Interruptfunktion der CTC Kanal 1"
        DEFB 0DH,0AH
        DEFM "* Test, ob K0 und K1 der CTC verbunden sind"
        DEFB 0DH,0AH
        DEFM "* Test, ob ein Quarz an K0 angeschlossen ist"
        DEFB 0DH,0AH,0DH,0AH
        DEFM "--> AC1 System-CTC hat die I/O-Adresse: 00"
        DEFB 0DH,0AH
        DEFM "--> I/O-Adresse der AC1 Soundkarte-CTC: 3C"
        DEFB 0DH,0AH,0DH,0AH
        DEFM "Eingabe der I/O-Adresse (hex) = "
        DEFB 00H
;
KORTXT: DEFM " --> Korrektur: "
        DEFB 00H
;
RDYTXT: DEFB 0DH,0AH,0DH,0AH
        DEFM "--> CTC funktioniert!"
        DEFB 0DH,0AH,0DH,0AH,00H
;
BRK1TX: DEFM "Abbruch: keine CTC erkannt!"
        DEFB 0DH,0AH,0DH,0AH,00H
;
BRK2TX: DEFM "Abbruch: K0 und K1 sind nicht verbunden!"
        DEFB 0DH,0AH,0DH,0AH,00H
;
BRK3TX: DEFM "Abbruch: kein Quarz an K0 angeschlossen!"
        DEFB 0DH,0AH,0DH,0AH,00H
;
K0TXT:  DEFB 0DH,0AH,0DH,0AH
        DEFM "Interrupttest K0:"
        DEFB 0DH,0AH,00H
;
K1TXT:  DEFB 0DH,0AH,0DH,0AH
        DEFM "Interrupttest K1:"
        DEFB 0DH,0AH,00H
;
K01TXT: DEFB 0DH,0AH,0DH,0AH
        DEFM "Interrupttest K0 + K1:"
        DEFB 0DH,0AH,00H
;
Q01TXT: DEFB 0DH,0AH,0DH,0AH
        DEFM "Interrupttest mit Quarz an K0 + K1:"
        DEFB 0DH,0AH,00H
;
; CTC-Programmierung
; ==================
;
CTCK0:  DEFB 0A7H,157,3,3
CTCK1:  DEFB 3,3,0A7H,157
CTCK01: DEFB 27H,4,0C7H,39
CTCQ01: DEFB 47H,157,0C7H,57
;
; Programmstart
; =============
;
START:
        IFDEF CPM
        LD   SP,0100H     ;CP/M - Stack
        ELSE
        DEFB 00H,09H,78H,0DH   ;Kennbuchstabe 'x'
        LD   SP,1856H     ;AC1 - Stack
        ENDIF
;
; BIOS-Routinen: HWT-Adresse patchen
; ==================================
;
        IFDEF CPM
        LD   A,(WBOOT+2)  ;HWT Adresse WBOOT lesen
        LD   (PATCH1+2),A ;HWT Adresse CONST
        LD   (PATCH2+2),A ;HWT Adresse CONIN
        LD   (PATCH3+2),A ;HWT Adresse CONOUT
        LD   (PATCH4+2),A ;HWT Adresse CONOUT
        ENDIF
;
; Anfangstext und Kanalauswahl
; ============================
;
        LD   HL,ANFTXT    ;Anfangstext
        CALL OUTTXT
        CALL INHEX        ;1. HEX-Wert
        CALL OUTZEI
        LD   H,C
        AND  0FH          ;Maske: 0..F
        RLCA
        RLCA
        RLCA
        RLCA
        LD   D,A
        CALL INHEX        ;2. HEX-Wert
        CALL OUTZEI
        AND  0CH          ;Maske: 0,4,8,C
        OR   D
        LD   E,A          ;E --> unteres I/O-Adressbyte
;
; Test der Eingabe
; ================
;
        AND  0CH          ;Test unteres Adressbyte
        OR   '0'
        CP   3CH
        JR   NZ,TEST1
        ADD  A,7          ;3CH --> 'C'
TEST1:  LD   L,A
        CP   C
        JR   Z,ISRINI     ;Eingabe o.k.
        PUSH HL
        LD   HL,KORTXT    ;--> Korrektur:
        CALL OUTTXT
        POP  HL
        LD   C,H
        CALL OUTZEI
        LD   C,L
        CALL OUTZEI
;
; ISR-Init. + CTC-Reset
; =====================
;
ISRINI: DI
        LD   HL,ISRCTC    ;Einsprungpunkt ISR
        LD   (IV),HL
        LD   (IV+2),HL
        LD   A,HIGH(IV)   ;Int.-vektor HWT
        LD   I,A
        LD   B,0          ;oberes I/O-Adressbyte
        LD   C,E          ;unteres I/O-Adressbyte
        LD   A,3          ;CTC-Reset
        OUT  (C),A
NEXT:   INC  C            ;I/O-Adresse++
        OUT  (C),A
        INC  C
        OUT  (C),A
        INC  C
        OUT  (C),A        ;Komplett-Reset wg. HRCPM12!
;
; Testroutinen und Finis
; ======================
;
        LD   HL,K0TXT     ;Kanal 1
        CALL OUTTXT
        LD   IX,CTCK0
        CALL CTCINI
        OR   A
        JR   NZ,BREAK1
;
        LD   HL,K1TXT     ;Kanal 2
        CALL OUTTXT
        LD   IX,CTCK1
        CALL CTCINI
        OR   A
        JR   NZ,BREAK1
;
        LD   HL,K01TXT    ;Kanal 1 + Kanal 2
        CALL OUTTXT
        LD   IX,CTCK01
        CALL CTCINI
        OR   A
        JR   NZ,BREAK2
;
        LD   HL,Q01TXT    ;Quarz an K0 + K1
        CALL OUTTXT
        LD   IX,CTCQ01
        CALL CTCINI
        OR   A
        JR   NZ,BREAK3
;
        LD   HL,RDYTXT    ;CTC funktioniert!
        CALL OUTTXT
        JR   FINIS
;
BREAK1: LD   HL,BRK1TX    ;Abbruch: keine CTC erkannt!
        CALL OUTTXT
        JR   FINIS
;
BREAK2: LD   HL,BRK2TX    ;Abbruch: K0 und K1 sind nicht verbunden!
        CALL OUTTXT
        JR   FINIS
;
BREAK3: LD   HL,BRK3TX    ;Abbruch: kein Quarz an K0 angeschlossen!
        CALL OUTTXT
;
FINIS:
        IFDEF CPM
        JP   WBOOT        ;CP/M: WBOOT
        ELSE
        JP   GETCO        ;AC1-Monitor
        ENDIF
;
; CTC - Initialisierung
; =====================
;
CTCINI: LD   B,0          ;oberes I/O-Adressbyte
        LD   C,E          ;unteres I/O-Adressbyte
        LD   A,LOW(IV)    ;Int.-vektor NWT
        OUT  (C),A
        LD   A,(IX)       ;Kanalsteuerwort K1
        OUT  (C),A
        LD   A,(IX+1)     ;Zeitkonstante K1
        OUT  (C),A
        INC  C            ;I/O-Adresse++
        LD   A,(IX+2)     ;Kanalsteuerwort K2
        OUT  (C),A
        LD   A,(IX+3)     ;Zeitkonstante K2
        OUT  (C),A
        IM   2
;
; Interruptfreigabe und Loop
; ==========================
;
        LD   B,58         ;Anzahl der Zeichen
        LD   C,'A'        ;1. Zeichen
        LD   D,5          ;Zaehler #2 fuer Abbruch
        LD   HL,0         ;Zaehler #1 fuer Abbruch
        LD   (CHARBC),BC
        LD   (CNTRDE),DE
        LD   (CNTRHL),HL
        EI
;
LOOP1:  LD   HL,(CNTRHL)  ;Loop: Warten auf Interrupts
        DEC  HL
        LD   A,H
        OR   L
        JR   NZ,LOOP2
        LD   DE,(CNTRDE)
        DEC  D
        LD   A,1
        RET  Z            ;Abbruch: keine CTC erkannt!
        LD   (CNTRDE),DE
LOOP2:  LD   (CNTRHL),HL
        LD   BC,(CHARBC)
        INC  B
        DEC  B 
        JR   NZ,LOOP1
;
; CTC-Reset K0 + K1
; =================
;
        LD   B,0          ;oberes I/O-Adressbyte
        LD   C,E          ;unteres I/O-Adressbyte
        LD   A,3          ;CTC-Reset
        OUT  (C),A
        INC  C            ;I/O-Adresse++
        OUT  (C),A
        XOR  A
        RET               ;alle Zeichen ausgegeben
;
; Interrupt-Serviceroutine
; ========================
;
ISRCTC: LD   (SAVSTK),SP  ;DI kann wegbleiben
        LD   SP,ISRSTK    ;eigener ISR-Stack
        EI
        PUSH AF
        PUSH BC
        PUSH DE
        PUSH HL
        LD   BC,(CHARBC)
        LD   DE,(CNTRDE)
        LD   HL,0         ;Zaehler #1 ruecksetzen
        LD   D,5          ;Zaehler #2 ruecksetzen
        CALL OUTZEI       ;Zeichen in C ausgeben
        INC  C
        DEC  B
        LD   A,C
        CP   7FH
        JR   NZ,ISR2
        LD   C,' '
ISR2:   LD   (CHARBC),BC
        LD   (CNTRDE),DE
        LD   (CNTRHL),HL
        POP  HL
        POP  DE
        POP  BC
        POP  AF
        DI
        LD   SP,(SAVSTK)
        EI
        RETI
;
; Speicherzellen
; ==============
;
CHARBC: DEFW 0            ;Zeichenausgabe ISR + Counter
CNTRDE: DEFW 0            ;Zaehler #2 fuer Abbruch + I/O Adr.
CNTRHL: DEFW 0            ;Zaehler #1 fuer Abbruch
SAVSTK: DEFS 40,0         ;eigener ISR-Stack
ISRSTK:
;
        DEFM "finis"
;
        .DEPHASE
        END
;