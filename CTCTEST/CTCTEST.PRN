  0479    DD 21 03D3                    LD   IX,CTCQ01
  047D    CD 04A4                       CALL CTCINI
  0480    B7                            OR   A
  0481    20 18                         JR   NZ,BREAK3
                                ;
  0483    21 02B8                       LD   HL,RDYTXT    ;CTC funktioniert!
  0486    CD 011A                       CALL OUTTXT
  0489    18 16                         JR   FINIS
                                ;
  048B    21 02D6               BREAK1: LD   HL,BRK1TX    ;Abbruch: keine CTC erkannt!
  048E    CD 011A                       CALL OUTTXT
  0491    18 0E                         JR   FINIS
                                ;
  0493    21 02F6               BREAK2: LD   HL,BRK2TX    ;Abbruch: K0 und K1 sind nicht verbunden!
  0496    CD 011A                       CALL OUTTXT
  0499    18 06                         JR   FINIS
                                ;
  049B    21 0323               BREAK3: LD   HL,BRK3TX    ;Abbruch: kein Quarz an K0 angeschlossen!
  049E    CD 011A                       CALL OUTTXT
                                ;
  04A1                          FINIS:
                                        IFDEF CPM
  04A1    C3 0000                       JP   WBOOT        ;CP/M: WBOOT
                                        ELSE
                                        JP   GETCO        ;AC1-Monitor
                                        ENDIF
                                ;
                                ; CTC - Initialisierung
                                ; =====================
                                ;
  04A4    06 00                 CTCINI: LD   B,0          ;oberes I/O-Adressbyte
  04A6    4B                            LD   C,E          ;unteres I/O-Adressbyte
  04A7    3E 90                         LD   A,LOW(IV)    ;Int.-vektor NWT
  04A9    ED 79                         OUT  (C),A
  04AB    DD 7E 00                      LD   A,(IX)       ;Kanalsteuerwort K1
  04AE    ED 79                         OUT  (C),A
  04B0    DD 7E 01                      LD   A,(IX+1)     ;Zeitkonstante K1
  04B3    ED 79                         OUT  (C),A
  04B5    0C                            INC  C            ;I/O-Adresse++
  04B6    DD 7E 02                      LD   A,(IX+2)     ;Kanalsteuerwort K2
  04B9    ED 79                         OUT  (C),A
  04BB    DD 7E 03                      LD   A,(IX+3)     ;Zeitkonstante K2
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  04BE    ED 79                         OUT  (C),A
  04C0    ED 5E                         IM   2
                                ;
                                ; Interruptfreigabe und Loop
                                ; ==========================
                                ;
  04C2    06 3A                         LD   B,58         ;Anzahl der Zeichen
  04C4    0E 41                         LD   C,'A'        ;1. Zeichen
  04C6    16 05                         LD   D,5          ;Zaehler #2 fuer Abbruch
  04C8    21 0000                       LD   HL,0         ;Zaehler #1 fuer Abbruch
  04CB    ED 43 053E                    LD   (CHARBC),BC
  04CF    ED 53 0540                    LD   (CNTRDE),DE
  04D3    22 0542                       LD   (CNTRHL),HL
  04D6    FB                            EI
                                ;
  04D7    2A 0542               LOOP1:  LD   HL,(CNTRHL)  ;Loop: Warten auf Interrupts
  04DA    2B                            DEC  HL
  04DB    7C                            LD   A,H
  04DC    B5                            OR   L
  04DD    20 0C                         JR   NZ,LOOP2
  04DF    ED 5B 0540                    LD   DE,(CNTRDE)
  04E3    15                            DEC  D
  04E4    3E 01                         LD   A,1
  04E6    C8                            RET  Z            ;Abbruch: keine CTC erkannt!
  04E7    ED 53 0540                    LD   (CNTRDE),DE
  04EB    22 0542               LOOP2:  LD   (CNTRHL),HL
  04EE    ED 4B 053E                    LD   BC,(CHARBC)
  04F2    04                            INC  B
  04F3    05                            DEC  B 
  04F4    20 E1                         JR   NZ,LOOP1
                                ;
                                ; CTC-Reset K0 + K1
                                ; =================
                                ;
  04F6    06 00                         LD   B,0          ;oberes I/O-Adressbyte
