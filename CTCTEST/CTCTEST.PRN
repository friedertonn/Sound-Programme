                                ;
                                ; CTC-Programmierung
                                ; ==================
                                ;
  03C7    A7 9D 03 03           CTCK0:  DEFB 0A7H,157,3,3
  03CB    03 03 A7 9D           CTCK1:  DEFB 3,3,0A7H,157
  03CF    27 04 C7 27           CTCK01: DEFB 27H,4,0C7H,39
  03D3    47 9D C7 39           CTCQ01: DEFB 47H,157,0C7H,57
                                ;
                                ; Programmstart
                                ; =============
                                ;
  03D7                          START:
                                        IFDEF CPM
  03D7    31 0100                       LD   SP,0100H     ;CP/M - Stack
                                        ELSE
                                        DEFB 00H,09H,78H,0DH   ;Kennbuchstabe 'x'
                                        LD   SP,1856H     ;AC1 - Stack
                                        ENDIF
                                ;
                                ; BIOS-Routinen: HWT-Adresse patchen
                                ; ==================================
                                ;
                                        IFDEF CPM
  03DA    3A 0002                       LD   A,(WBOOT+2)  ;HWT Adresse WBOOT lesen
  03DD    32 010A                       LD   (PATCH1+2),A ;HWT Adresse CONST
  03E0    32 010E                       LD   (PATCH2+2),A ;HWT Adresse CONIN
  03E3    32 0115                       LD   (PATCH3+2),A ;HWT Adresse CONOUT
  03E6    32 0125                       LD   (PATCH4+2),A ;HWT Adresse CONOUT
                                        ENDIF
                                ;
                                ; Anfangstext und Kanalauswahl
                                ; ============================
                                ;
  03E9    21 0149                       LD   HL,ANFTXT    ;Anfangstext
  03EC    CD 011A                       CALL OUTTXT
  03EF    CD 012D                       CALL INHEX        ;1. HEX-Wert
  03F2    CD 0110                       CALL OUTZEI
  03F5    61                            LD   H,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  03F6    E6 0F                         AND  0FH          ;Maske: 0..F
  03F8    07                            RLCA
  03F9    07                            RLCA
  03FA    07                            RLCA
  03FB    07                            RLCA
  03FC    57                            LD   D,A
  03FD    CD 012D                       CALL INHEX        ;2. HEX-Wert
  0400    CD 0110                       CALL OUTZEI
  0403    E6 0C                         AND  0CH          ;Maske: 0,4,8,C
  0405    B2                            OR   D
  0406    5F                            LD   E,A          ;E --> unteres I/O-Adressbyte
                                ;
                                ; Test der Eingabe
                                ; ================
                                ;
  0407    E6 0C                         AND  0CH          ;Test unteres Adressbyte
  0409    F6 30                         OR   '0'
  040B    FE 3C                         CP   3CH
  040D    20 02                         JR   NZ,TEST1
  040F    C6 07                         ADD  A,7          ;3CH --> 'C'
  0411    6F                    TEST1:  LD   L,A
  0412    B9                            CP   C
  0413    28 10                         JR   Z,ISRINI     ;Eingabe o.k.
  0415    E5                            PUSH HL
  0416    21 02A7                       LD   HL,KORTXT    ;--> Korrektur:
  0419    CD 011A                       CALL OUTTXT
  041C    E1                            POP  HL
  041D    4C                            LD   C,H
  041E    CD 0110                       CALL OUTZEI
  0421    4D                            LD   C,L
  0422    CD 0110                       CALL OUTZEI
                                ;
                                ; ISR-Init. + CTC-Reset
                                ; =====================
                                ;
  0425    F3                    ISRINI: DI
  0426    21 0502                       LD   HL,ISRCTC    ;Einsprungpunkt ISR
  0429    22 FF90                       LD   (IV),HL
  042C    22 FF92                       LD   (IV+2),HL
  042F    3E FF                         LD   A,HIGH(IV)   ;Int.-vektor HWT
  0431    ED 47                         LD   I,A
  0433    06 00                         LD   B,0          ;oberes I/O-Adressbyte
  0435    4B                            LD   C,E          ;unteres I/O-Adressbyte
  0436    3E 03                         LD   A,3          ;CTC-Reset
  0438    ED 79                         OUT  (C),A
  043A    0C                    NEXT:   INC  C            ;I/O-Adresse++
  043B    ED 79                         OUT  (C),A
  043D    0C                            INC  C
  043E    ED 79                         OUT  (C),A
  0440    0C                            INC  C
  0441    ED 79                         OUT  (C),A        ;Komplett-Reset wg. HRCPM12!
                                ;
                                ; Testroutinen und Finis
                                ; ======================
                                ;
  0443    21 0350                       LD   HL,K0TXT     ;Kanal 1
  0446    CD 011A                       CALL OUTTXT
  0449    DD 21 03C7                    LD   IX,CTCK0
  044D    CD 04A4                       CALL CTCINI
  0450    B7                            OR   A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0451    20 38                         JR   NZ,BREAK1
                                ;
  0453    21 0368                       LD   HL,K1TXT     ;Kanal 2
  0456    CD 011A                       CALL OUTTXT
  0459    DD 21 03CB                    LD   IX,CTCK1
  045D    CD 04A4                       CALL CTCINI
  0460    B7                            OR   A
  0461    20 28                         JR   NZ,BREAK1
                                ;
  0463    21 0380                       LD   HL,K01TXT    ;Kanal 1 + Kanal 2
  0466    CD 011A                       CALL OUTTXT
  0469    DD 21 03CF                    LD   IX,CTCK01
  046D    CD 04A4                       CALL CTCINI
  0470    B7                            OR   A
  0471    20 20                         JR   NZ,BREAK2
                                ;
  0473    21 039D                       LD   HL,Q01TXT    ;Quarz an K0 + K1
