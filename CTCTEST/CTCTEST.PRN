	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ; ***************************************************
                                ; *                                                 *
                                ; *  CTC-Testprogramm       Version vom 18.11.2026  *
                                ; *  ================               von Frieder     *
                                ; *                                                 *
                                ; ***************************************************
                                ;
                                ; Kurz-Dokumentation:
                                ; - 4 Tests der Interruptfunktion der CTC
                                ; - Kanal 0 und 1 der CTC sind verbunden
                                ; - Interrupt alle 20 Millisekunden
                                ; - funktioniert mit dem AC1-Monitor und unter CP/M
                                ;
                                ; Assemblieren des Quelltextes unter CP/M:
                                ; M80 = CTCTEST
                                ; LINKMT CTCTEST
                                ;
                                ; ***************************************************
                                ; *  Wichtig: Fuer das AC1-Programm muss die        *
                                ; *           folgende Zeile auskommentiert werden  *
                                ; ***************************************************
  0001                          CPM     EQU  1            ;CP/M-Version
                                ;
                                        PAGE 64
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                                
                                        IF1
                                        IFDEF CPM
                                        .PRINTX 'CP/M-Version'
                                        ELSE
                                        .PRINTX 'Version fuer den AC1-Monitor'
                                        ENDIF
                                        .PRINTX 'PASS 1'
                                        ENDIF
                                ;
                                        IF2
                                        .PRINTX 'PASS 2'
                                        ENDIF
                                ;
                                        .CREF
                                        .Z80
                                        IFDEF CPM
                                        .PHASE 100H       ;CP/M-Programm startet bei 100H
                                        ELSE
                                        .PHASE 2000H      ;AC1-Programm startet bei 2000H
                                        ENDIF
                                ;
  0000                          WBOOT   EQU  00000H       ;Warmstart
  E606                          CONST   EQU  0E606H       ;BIOS - CONST
  E609                          CONIN   EQU  0E609H       ;BIOS - CONIN
  E60C                          CONOUT  EQU  0E60CH       ;BIOS - CONOUT
                                ;
  07FD                          GETCO   EQU  07FDH        ;AC1-Monitor - Eingabeschleife
                                ;
  0100    C3 03D7                       JP   START
  0103                                  DEFS 5,0
                                ;
                                ;
                                ; Interruptvektoren-Tabelle
                                ;
                                        IFDEF CPM
  FF90                          IV      EQU  0FF90H       ;USER-Interruptvektoren
                                        ELSE
                                IV:     DEFS 8,0          ;im AC1-Monitor Adr. 2008H
                                        ENDIF
                                ;
                                ; UP Taste gedrueckt?
                                ; ===================
                                ;
  0108                          TASTE:
                                        IFDEF CPM
  0108    CD E606               PATCH1: CALL CONST        ;CP/M: CONST
                                        ELSE
                                        IN   A,(04H)      ;AC1: PIO1 Port A lesen
                                        RES  7,A
                                        OR   A
                                        JR   Z,TASTE1
                                        LD   A,0FFH       ;Taste gedrueckt
                                        ENDIF
  010B    C9                    TASTE1: RET
                                ;
                                ; UP Zeicheneingabe
                                ; =================
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  010C                          INZEI:
                                        IFDEF CPM
  010C    CD E609               PATCH2: CALL CONIN        ;CP/M: CONIN
                                        ELSE
                                INZEI1: IN   A,(04H)      ;AC1: PIO1 Port A lesen
                                        RES  7,A
                                        OR   A
                                        JR   NZ,INZEI1    ;(falsche) Taste gedrueckt
                                INZEI2: IN   A,(04H)      ;AC1: PIO1 Port A lesen
                                        RES  7,A
                                        OR   A
                                        JR   Z,INZEI2     ;keine Taste gedrueckt
                                        ENDIF
  010F    C9                            RET
                                ;
                                ; UP Zeichenausgabe
                                ; =================
                                ;
  0110    F5                    OUTZEI: PUSH AF
  0111    C5                            PUSH BC
  0112    D5                            PUSH DE           ;wg. CONOUT im HRCPM12!
                                        IFDEF CPM
  0113    CD E60C               PATCH3: CALL CONOUT       ;CP/M: CONOUT
                                        ELSE
                                        LD  A,C
                                        CP  0AH           ;AC1: 0AH nicht ausgeben
                                        JR  Z,OUTZE1
                                        RST 10H           ;AC1: RST 10H
                                        ENDIF
  0116    D1                    OUTZE1: POP  DE
  0117    C1                            POP  BC
  0118    F1                            POP  AF
  0119    C9                            RET
                                ;
                                ; UP Textausgabe
                                ; ==============
                                ;
  011A    F5                    OUTTXT: PUSH AF
  011B    C5                            PUSH BC
  011C    D5                            PUSH DE           ;wg. CONOUT im HRCPM12!
  011D    7E                    OUTTX1: LD   A,(HL)
  011E    FE 00                         CP   0            ;Ende
  0120    28 07                         JR   Z,OUTTX3
                                        IFDEF CPM
  0122    4F                            LD   C,A
  0123    CD E60C               PATCH4: CALL CONOUT       ;CP/M: CONOUT
                                        ELSE
                                        CP  0AH           ;0AH nicht ausgeben
                                        JR  Z,OUTTX2
                                        RST 10H           ;AC1: RST 10H
                                        ENDIF
  0126    23                    OUTTX2: INC  HL
  0127    18 F4                         JR   OUTTX1
  0129    D1                    OUTTX3: POP  DE
  012A    C1                            POP  BC
  012B    F1                            POP  AF
  012C    C9                            RET
                                ;
                                ; UP Eingabe einer HEX-Ziffer
                                ; ===========================
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                ;
  012D    CD 010C               INHEX:  CALL INZEI        ;Zeicheneingabe --> A
  0130    4F                            LD   C,A
  0131    FE 30                         CP   '0'          ;kleiner als "0"?
  0133    38 F8                         JR   C,INHEX
  0135    FE 3A                         CP   '9'+1        ;kleiner als "9"?
  0137    38 0D                         JR   C,INHEXE
  0139    E6 5F                         AND  5FH          ;Kleinbuchstaben --> Grossb.
  013B    FE 41                         CP   'A'          ;kleiner als "A"?
  013D    38 EE                         JR   C,INHEX
  013F    FE 47                         CP   'F'+1        ;groesser als "F"?
  0141    30 EA                         JR   NC,INHEX
  0143    4F                            LD   C,A          ;ASCII-Zeichen steht in C
  0144    D6 07                         SUB  7
  0146    D6 30                 INHEXE: SUB  '0'          ;HEX-Code steht in A
  0148    C9                            RET
