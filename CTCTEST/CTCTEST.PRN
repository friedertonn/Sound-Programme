  0262    20 2D 2D 3E           KORTXT: DEFM " --> Korrektur: "
  0266    20 4B 6F 72           
  026A    72 65 6B 74           
  026E    75 72 3A 20           
  0272    00                            DEFB 00H
                                ;
  0273    0D 0A 0D 0A           BRKTXT: DEFB 0DH,0AH,0DH,0AH
  0277    41 62 62 72                   DEFM "Abbruch!"
  027B    75 63 68 21           
  027F    0D 0A 0D 0A                   DEFB 0DH,0AH,0DH,0AH,00H
  0283    00                    
                                ;
  0284    0D 0A 0D 0A           RDYTXT: DEFB 0DH,0AH,0DH,0AH
  0288    46 75 6E 6B                   DEFM "Funktioniert!"
  028C    74 69 6F 6E           
  0290    69 65 72 74           
  0294    21                    
  0295    0D 0A 0D 0A                   DEFB 0DH,0AH,0DH,0AH,00H
  0299    00                    
                                ;
  029A    0D 0A                 CTCTXT: DEFB 0DH,0AH
  029C    46 65 68 6C                   DEFM "Fehler: keine CTC auf dieser Adresse!"
  02A0    65 72 3A 20           
  02A4    6B 65 69 6E           
  02A8    65 20 43 54           
  02AC    43 20 61 75           
  02B0    66 20 64 69           
  02B4    65 73 65 72           
  02B8    20 41 64 72           
  02BC    65 73 73 65           
  02C0    21                    
  02C1    0D 0A 0D 0A                   DEFB 0DH,0AH,0DH,0AH,00H
  02C5    00                    
                                ;
  02C6    0D 0A 00              NL1TXT: DEFB 0DH,0AH,00H
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  02C9    0D 0A 0D 0A           NL2TXT: DEFB 0DH,0AH,0DH,0AH,00H
  02CD    00                    
                                ;
                                ; Programmstart
                                ; =============
                                ;
  02CE                          START:
                                        IFDEF CPM
  02CE    31 0100                       LD   SP,0100H     ;CP/M - Stack
                                        ELSE
                                        DEFB 00H,09H,78H,0DH
                                        LD   SP,1856H     ;AC1 - Stack
                                        ENDIF
                                ;
                                ; BIOS-Routinen: HWT-Adresse patchen
                                ; ==================================
                                ;
                                        IFDEF CPM
  02D1    3A 0002                       LD   A,(WBOOT+2)  ;HWT Adresse WBOOT lesen
  02D4    32 010A                       LD   (PATCH1+2),A ;HWT Adresse CONST
  02D7    32 010E                       LD   (PATCH2+2),A ;HWT Adresse CONIN
  02DA    32 0114                       LD   (PATCH3+2),A ;HWT Adresse CONOUT
  02DD    32 0122                       LD   (PATCH4+2),A ;HWT Adresse CONOUT
                                        ENDIF
                                ;
                                ; Anfangstext und Kanalauswahl
                                ; ============================
                                ;
  02E0    21 0129                       LD   HL,ANFTXT    ;Anfangstext
  02E3    CD 0118                       CALL OUTTXT
  02E6    CD 0371                       CALL INHEX        ;1. HEX-Wert
  02E9    61                            LD   H,C
  02EA    E6 0F                         AND  0FH          ;Maske: 0..F
  02EC    07                            RLCA
  02ED    07                            RLCA
  02EE    07                            RLCA
  02EF    07                            RLCA
  02F0    57                            LD   D,A
  02F1    CD 0371                       CALL INHEX        ;2. HEX-Wert
  02F4    E6 0C                         AND  0CH          ;Maske: 0,4,8,C
  02F6    B2                            OR   D
  02F7    5F                            LD   E,A          ;unteres I/O-Adressbyte
                                ;
                                ; Test der Eingabe
                                ; ================
                                ;
  02F8    E6 0C                         AND  0CH          ;Test unteres Adressbyte
  02FA    F6 30                         OR   '0'
  02FC    FE 3C                         CP   3CH
  02FE    20 02                         JR   NZ,TEST1
  0300    C6 07                         ADD  A,7          ;3C --> 'C'
  0302    6F                    TEST1:  LD   L,A
  0303    B9                            CP   C
  0304    28 10                         JR   Z,TEST2
  0306    E5                            PUSH HL
  0307    21 0262                       LD   HL,KORTXT    ;--> Korrektur:
  030A    CD 0118                       CALL OUTTXT
  030D    E1                            POP  HL
  030E    4C                            LD   C,H
  030F    CD 0110                       CALL OUTZEI
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  0312    4D                            LD   C,L
  0313    CD 0110                       CALL OUTZEI
  0316    21 02C9               TEST2:  LD   HL,NL2TXT
  0319    CD 0118                       CALL OUTTXT
                                ;
                                ; CTC - Initialisierung
                                ; =====================
                                ;
  031C    F3                            DI
  031D    21 039D                       LD   HL,ISRCTC    ;Einsprungpunkt CTC-Interrupt
  0320    22 FF92                       LD   (IV+2),HL
  0323    3E FF                         LD   A,HIGH(IV)   ;Int.-vektor HWT
  0325    ED 47                         LD   I,A
  0327    3E 90                         LD   A,LOW(IV)    ;Int.-vektor NWT --> 4008H
  0329    06 00                         LD   B,0          ;oberes I/O-Adressbyte
  032B    4B                            LD   C,E          ;unteres I/O-Adressbyte
  032C    ED 79                         OUT  (C),A
  032E    3E 27                         LD   A,27H        ;Kanalsteuerwort
  0330    ED 79                         OUT  (C),A
  0332    3E 04                         LD   A,4          ;Zeitkonstante
  0334    ED 79                         OUT  (C),A
  0336    3E C7                         LD   A,0C7H       ;Kanalsteuerwort
  0338    D3 01                         OUT  (CTC+1),A
  033A    3E 27                         LD   A,39         ;Zeitkonstante
  033C    D3 01                         OUT  (CTC+1),A
  033E    ED 5E                         IM   2
                                ;
                                ; Interruptfreigabe und Loop
                                ; ==========================
                                ;
                                
  0340    FB                            EI
  0341    0E 20                         LD   C,' '        ;1. Zeichen
  0343    06 BF                         LD   B,191        ;Anzahl der Zeichen
  0345    21 0000                       LD   HL,0
  0348    16 05                         LD   D,5
  034A    2B                    M1:     DEC  HL
  034B    7C                            LD   A,H
  034C    B5                            OR   L
  034D    20 03                         JR   NZ,M2
  034F    15                            DEC  D
  0350    28 17                         JR   Z,NOCTC      ;keine CTC auf dieser Adresse!
  0352    04                    M2:     INC  B
  0353    05                            DEC  B
  0354    20 F4                         JR   NZ,M1
                                ;
                                ; Programmende
                                ; ============
                                ;
  0356    3E 03                         LD   A,03H        ;Kanalsteuerwort - Reset
  0358    06 00                         LD   B,0          ;oberes I/O-Adressbyte
  035A    4B                            LD   C,E          ;unteres I/O-Adressbyte
  035B    ED 79                         OUT  (C),A
  035D    0C                            INC  C
  035E    ED 79                         OUT  (C),A
  0360    21 0284                       LD   HL,RDYTXT    ;Funktioniert!
  0363    CD 0118                       CALL OUTTXT
  0366                          FINIS:
                                        IFDEF CPM
  0366    C3 0000                       JP   WBOOT        ;CP/M: WBOOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


                                        ELSE
                                        JP   GETCO        ;AC1: Eingabeschleife
                                        ENDIF
                                ;
  0369    21 029A               NOCTC:  LD   HL,CTCTXT    ;keine CTC auf dieser Adresse!
  036C    CD 0118                       CALL OUTTXT
  036F    18 F5                         JR   FINIS
                                ;
                                ; Eingabe und Ausgabe einer HEX-Ziffer (Erg. in A + C)
                                ; ====================================
                                ;
  0371    CD 010C               INHEX:  CALL INZEI        ;Zeicheneingabe --> A
  0374    4F                            LD   C,A
  0375    FE 03                         CP   03H          ;Abbruch?
  0377    CA 0395                       JP   Z,ABRUCH
  037A    FE 30                         CP   '0'          ;kleiner als "0"?
  037C    38 F3                         JR   C,INHEX
  037E    FE 3A                         CP   '9'+1        ;kleiner als "9"?
  0380    38 0D                         JR   C,INHEXE
  0382    E6 5F                         AND  5FH          ;Kleinbuchstaben --> Grossb.
  0384    FE 41                         CP   'A'          ;kleiner als "A"?
  0386    38 E9                         JR   C,INHEX
  0388    FE 47                         CP   'F'+1        ;groesser als "F"?
  038A    30 E5                         JR   NC,INHEX
  038C    4F                            LD   C,A
  038D    D6 07                         SUB  7
  038F    CD 0110               INHEXE: CALL OUTZEI       ;Zeichen in C ausgeben
  0392    D6 30                         SUB  '0'
  0394    C9                            RET
                                ;
  0395    21 0273               ABRUCH: LD   HL,BRKTXT    ;Anzeige: Abbruch!
  0398    CD 0118                       CALL OUTTXT
  039B    18 C9                         JR   FINIS
                                ;
                                ; Interrupt-Serviceroutine
                                ; ========================
                                ;
  039D    F3                    ISRCTC: DI                ;Interruptentry
  039E    21 0000                       LD   HL,0
  03A1    16 05                         LD   D,5
  03A3    CD 0110                       CALL OUTZEI       ;Zeichen in C ausgeben
  03A6    0C                            INC  C
  03A7    05                            DEC  B
  03A8    79                            LD   A,C
  03A9    FE 7F                         CP   7FH
  03AB    20 02                         JR   NZ,M3
  03AD    0E 20                         LD   C,' '
  03AF    FB                    M3:     EI
  03B0    ED 4D                         RETI
                                ;
  03B2    66 69 6E 69                   DEFM "finis"
  03B6    73                    
                                ;
                                        .DEPHASE
                                        END
