  01FF    20 64 69 65           
  0203    20 49 2F 4F           
  0207    2D 41 64 72           
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  020B    65 73 73 65           
  020F    3A 20 30 30           
  0213    0D 0A                         DEFB 0DH,0AH
  0215    2D 20 49 2F                   DEFM "- I/O-Adresse der AC1 Soundkarte-CTC: 3C"
  0219    4F 2D 41 64           
  021D    72 65 73 73           
  0221    65 20 64 65           
  0225    72 20 41 43           
