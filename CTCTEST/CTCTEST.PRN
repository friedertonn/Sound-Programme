	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ; ***************************************************
                                ; *                                                 *
                                ; *  CTC-Testprogramm       Version vom 16.11.2026  *
                                ; *                                                 *
                                ; ***************************************************
                                ;
                                ; Dokumentation:
                                ; - Test der Interruptfunktion der CTC
                                ; - Kanal 0 und 1 der CTC sind verbunden
                                ; - Interrupt alle 20 Millisekunden
                                ;
                                ; ***************************************************
                                ; *  Wichtig: Fuer das AC1-Programm muss die        *
                                ; *           folgende Zeile auskommentiert werden  *
                                ; ***************************************************
  0001                          CPM     EQU  1            ;CP/M-Version
                                ;
                                        PAGE 64
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                                
                                        IF1
                                        IFDEF CPM
                                        .PRINTX 'CP/M-Version'
                                        ELSE
                                        .PRINTX 'Version fuer den AC1-Monitor'
                                        ENDIF
                                        .PRINTX 'PASS 1'
                                        ENDIF
                                ;
                                        IF2
                                        .PRINTX 'PASS 2'
                                        ENDIF
                                ;
                                        .CREF
                                        .Z80
                                        IFDEF CPM
                                        .PHASE 100H       ;CP/M-Programm startet bei 100H
                                        ELSE
                                        .PHASE 4000H      ;AC1-Programm startet bei 4000H
                                        ENDIF
                                ;
  0000                          WBOOT   EQU  00000H       ;Warmstart
  E606                          CONST   EQU  0E606H       ;BIOS - CONST
  E609                          CONIN   EQU  0E609H       ;BIOS - CONIN
  E60C                          CONOUT  EQU  0E60CH       ;BIOS - CONOUT
                                ;
  07FD                          GETCO   EQU  07FDH        ;AC1-Monitor - Eingabeschleife
                                ;
  0100    C3 02CE                       JP   START
  0103                                  DEFS 5,0
                                ;
                                ;
                                ; Interruptvektoren-Tabelle
                                ;
                                        IFDEF CPM
  FF90                          IV      EQU  0FF90H       ;USER-Interruptvektoren
                                        ELSE
                                IV:     DEFS 8,0          ;im AC1-Monitor Adr. 4008H
                                        ENDIF
                                ;
                                ; UP Taste gedrueckt?
                                ; ===================
                                ;
  0108                          TASTE:
                                        IFDEF CPM
  0108    CD E606               PATCH1: CALL CONST        ;CP/M: CONST
                                        ELSE
                                        IN   A,(04H)      ;AC1: PIO1 Port A lesen
                                        RES  7,A
                                        OR   A
                                        JR   Z,TASTE1
                                        LD   A,0FFH       ;Taste gedrueckt
                                        ENDIF
  010B    C9                    TASTE1: RET
                                ;
                                ; UP Zeicheneingabe
                                ; =================
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  010C                          INZEI:
                                        IFDEF CPM
  010C    CD E609               PATCH2: CALL CONIN        ;CP/M: CONIN
                                        ELSE
                                INZEI1: IN   A,(04H)      ;AC1: PIO1 Port A lesen
                                        RES  7,A
                                        OR   A
                                        JR   NZ,INZEI1    ;(falsche) Taste gedrueckt
                                INZEI2: IN   A,(04H)      ;AC1: PIO1 Port A lesen
                                        RES  7,A
                                        OR   A
                                        JR   Z,INZEI2     ;keine Taste gedrueckt
                                        ENDIF
  010F    C9                            RET
                                ;
                                ; UP Zeichenausgabe
                                ; =================
                                ;
  0110    F5                    OUTZEI: PUSH AF
  0111    C5                            PUSH BC
                                        IFDEF CPM
  0112    CD E60C               PATCH3: CALL CONOUT       ;CP/M: CONOUT
                                        ELSE
                                        LD  A,C
                                        CP  0AH           ;AC1: 0AH nicht ausgeben
                                        JR  Z,OUTZE1
                                        RST 10H           ;AC1: RST 10H
                                        ENDIF
  0115    C1                    OUTZE1: POP  BC
  0116    F1                            POP  AF
  0117    C9                            RET
                                ;
                                ; UP Textausgabe
                                ; ==============
                                ;
  0118    F5                    OUTTXT: PUSH AF
  0119    C5                            PUSH BC
  011A    7E                    OUTTX1: LD   A,(HL)
  011B    FE 00                         CP   0            ;Ende
  011D    28 07                         JR   Z,OUTTX3
                                        IFDEF CPM
  011F    4F                            LD   C,A
  0120    CD E60C               PATCH4: CALL CONOUT       ;CP/M: CONOUT
                                        ELSE
                                        CP  0AH           ;0AH nicht ausgeben
                                        JR  Z,OUTTX2
                                        RST 10H           ;AC1: RST 10H
                                        ENDIF
  0123    23                    OUTTX2: INC  HL
  0124    18 F4                         JR   OUTTX1
  0126    C1                    OUTTX3: POP  BC
  0127    F1                            POP  AF
  0128    C9                            RET
                                ;
                                ; Bildschirmausschriften
                                ; ======================
                                ;
  0129    0D 0A 0D 0A           ANFTXT: DEFB 0DH,0AH,0DH,0AH
  012D    43 54 43 2D                   DEFM "CTC-Testprogramm"
  0131    54 65 73 74           
