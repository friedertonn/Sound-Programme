  02C9    0D 0A 0D 0A           NL2TXT: DEFB 0DH,0AH,0DH,0AH,00H
  02CD    00                    
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


                                ;
                                ; Programmstart
                                ; =============
                                ;
  02CE                          START:
                                        IFDEF CPM
  02CE    31 0100                       LD   SP,0100H     ;CP/M - Stack
                                        ELSE
                                        DEFB 00H,09H,78H,0DH   ;Kennbuchstabe 'x'
                                        LD   SP,1856H     ;AC1 - Stack
                                        ENDIF
                                ;
                                ; BIOS-Routinen: HWT-Adresse patchen
                                ; ==================================
                                ;
                                        IFDEF CPM
  02D1    3A 0002                       LD   A,(WBOOT+2)  ;HWT Adresse WBOOT lesen
  02D4    32 010A                       LD   (PATCH1+2),A ;HWT Adresse CONST
  02D7    32 010E                       LD   (PATCH2+2),A ;HWT Adresse CONIN
  02DA    32 0114                       LD   (PATCH3+2),A ;HWT Adresse CONOUT
  02DD    32 0122                       LD   (PATCH4+2),A ;HWT Adresse CONOUT
                                        ENDIF
                                ;
                                ; Anfangstext und Kanalauswahl
                                ; ============================
                                ;
  02E0    21 0129                       LD   HL,ANFTXT    ;Anfangstext
  02E3    CD 0118                       CALL OUTTXT
  02E6    CD 0372                       CALL INHEX        ;1. HEX-Wert
  02E9    61                            LD   H,C
  02EA    E6 0F                         AND  0FH          ;Maske: 0..F
  02EC    07                            RLCA
  02ED    07                            RLCA
  02EE    07                            RLCA
  02EF    07                            RLCA
  02F0    57                            LD   D,A
  02F1    CD 0372                       CALL INHEX        ;2. HEX-Wert
  02F4    E6 0C                         AND  0CH          ;Maske: 0,4,8,C
  02F6    B2                            OR   D
  02F7    5F                            LD   E,A          ;unteres I/O-Adressbyte
                                ;
                                ; Test der Eingabe
                                ; ================
                                ;
  02F8    E6 0C                         AND  0CH          ;Test unteres Adressbyte
  02FA    F6 30                         OR   '0'
  02FC    FE 3C                         CP   3CH
  02FE    20 02                         JR   NZ,TEST1
  0300    C6 07                         ADD  A,7          ;3C --> 'C'
  0302    6F                    TEST1:  LD   L,A
  0303    B9                            CP   C
  0304    28 10                         JR   Z,TEST2
  0306    E5                            PUSH HL
  0307    21 0262                       LD   HL,KORTXT    ;--> Korrektur:
  030A    CD 0118                       CALL OUTTXT
  030D    E1                            POP  HL
  030E    4C                            LD   C,H
  030F    CD 0110                       CALL OUTZEI
  0312    4D                            LD   C,L
  0313    CD 0110                       CALL OUTZEI
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  0316    21 02C9               TEST2:  LD   HL,NL2TXT
  0319    CD 0118                       CALL OUTTXT
                                ;
                                ; CTC - Initialisierung
                                ; =====================
                                ;
  031C    F3                            DI
  031D    21 039E                       LD   HL,ISRCTC    ;Einsprungpunkt CTC-Interrupt
  0320    22 FF92                       LD   (IV+2),HL
  0323    3E FF                         LD   A,HIGH(IV)   ;Int.-vektor HWT
  0325    ED 47                         LD   I,A
  0327    3E 90                         LD   A,LOW(IV)    ;Int.-vektor NWT --> 4008H
  0329    06 00                         LD   B,0          ;oberes I/O-Adressbyte
  032B    4B                            LD   C,E          ;unteres I/O-Adressbyte
  032C    ED 79                         OUT  (C),A
  032E    3E 27                         LD   A,27H        ;Kanalsteuerwort
  0330    ED 79                         OUT  (C),A
  0332    3E 04                         LD   A,4          ;Zeitkonstante
  0334    ED 79                         OUT  (C),A
  0336    0C                            INC  C            ;I/O-Adressbyte + 1
  0337    3E C7                         LD   A,0C7H       ;Kanalsteuerwort
  0339    ED 79                         OUT  (C),A
  033B    3E 27                         LD   A,39         ;Zeitkonstante
  033D    ED 79                         OUT  (C),A
  033F    ED 5E                         IM   2
                                ;
                                ; Interruptfreigabe und Loop
                                ; ==========================
                                ;
                                
  0341    FB                            EI
  0342    0E 20                         LD   C,' '        ;1. Zeichen
  0344    06 BF                         LD   B,191        ;Anzahl der Zeichen
  0346    21 0000                       LD   HL,0
  0349    16 05                         LD   D,5
  034B    2B                    M1:     DEC  HL
  034C    7C                            LD   A,H
  034D    B5                            OR   L
  034E    20 03                         JR   NZ,M2
  0350    15                            DEC  D
  0351    28 17                         JR   Z,NOCTC      ;keine CTC auf dieser Adresse!
  0353    04                    M2:     INC  B
  0354    05                            DEC  B
  0355    20 F4                         JR   NZ,M1
                                ;
                                ; Programmende
                                ; ============
                                ;
  0357    3E 03                         LD   A,03H        ;Kanalsteuerwort - Reset
  0359    06 00                         LD   B,0          ;oberes I/O-Adressbyte
  035B    4B                            LD   C,E          ;unteres I/O-Adressbyte
  035C    ED 79                         OUT  (C),A
  035E    0C                            INC  C            ;I/O-Adressbyte + 1
  035F    ED 79                         OUT  (C),A
  0361    21 0284                       LD   HL,RDYTXT    ;Funktioniert!
  0364    CD 0118                       CALL OUTTXT
  0367                          FINIS:
                                        IFDEF CPM
  0367    C3 0000                       JP   WBOOT        ;CP/M: WBOOT
                                        ELSE
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


                                        JP   GETCO        ;AC1: Eingabeschleife
                                        ENDIF
                                ;
  036A    21 029A               NOCTC:  LD   HL,CTCTXT    ;keine CTC auf dieser Adresse!
  036D    CD 0118                       CALL OUTTXT
  0370    18 F5                         JR   FINIS
                                ;
                                ; Eingabe und Ausgabe einer HEX-Ziffer (Erg. in A + C)
                                ; ====================================
                                ;
  0372    CD 010C               INHEX:  CALL INZEI        ;Zeicheneingabe --> A
  0375    4F                            LD   C,A
  0376    FE 03                         CP   03H          ;Abbruch?
  0378    CA 0396                       JP   Z,ABRUCH
  037B    FE 30                         CP   '0'          ;kleiner als "0"?
  037D    38 F3                         JR   C,INHEX
  037F    FE 3A                         CP   '9'+1        ;kleiner als "9"?
  0381    38 0D                         JR   C,INHEXE
  0383    E6 5F                         AND  5FH          ;Kleinbuchstaben --> Grossb.
  0385    FE 41                         CP   'A'          ;kleiner als "A"?
  0387    38 E9                         JR   C,INHEX
  0389    FE 47                         CP   'F'+1        ;groesser als "F"?
  038B    30 E5                         JR   NC,INHEX
  038D    4F                            LD   C,A
  038E    D6 07                         SUB  7
  0390    CD 0110               INHEXE: CALL OUTZEI       ;Zeichen in C ausgeben
  0393    D6 30                         SUB  '0'
  0395    C9                            RET
                                ;
  0396    21 0273               ABRUCH: LD   HL,BRKTXT    ;Anzeige: Abbruch!
  0399    CD 0118                       CALL OUTTXT
  039C    18 C9                         JR   FINIS
                                ;
                                ; Interrupt-Serviceroutine
                                ; ========================
                                ;
  039E    F3                    ISRCTC: DI                ;Interruptentry
  039F    21 0000                       LD   HL,0
  03A2    16 05                         LD   D,5
  03A4    CD 0110                       CALL OUTZEI       ;Zeichen in C ausgeben
  03A7    0C                            INC  C
  03A8    05                            DEC  B
  03A9    79                            LD   A,C
  03AA    FE 7F                         CP   7FH
  03AC    20 02                         JR   NZ,M3
  03AE    0E 20                         LD   C,' '
  03B0    FB                    M3:     EI
  03B1    ED 4D                         RETI
                                ;
  03B3    66 69 6E 69                   DEFM "finis"
  03B7    73                    
                                ;
                                        .DEPHASE
                                        END
