040CBh 111100                           LD        DE,#11
040CEh            PT3TIME:              EQU       $+1
040CEh 212121                           LD        HL,#2121
040D1h 19                               ADD       HL,DE
040D2h 22CF40                           LD        (PT3TIME),HL
040D5h C37640                           JP        PT3TLP2
040D8h            PT3TSETSK:                      
