00000h                                                           ;PLAYER-ENGINE:
00000h                                                           ;VORTEX TRACKER II V1.0 PT3 PLAYER FOR ZX SPECTRUM
00000h                                                           ;(C)2004,2007 S.V.BULBA <VOROBEY@MAIL.KHSTU.RU>
00000h                                                           ;HTTP://BULBA.UNTERGRUND.NET (HTTP://BULBA.AT.KZ)
00000h                                                           ;-------------------------------------------------
00000h                                                           ;Anpassung für AC1 mit 4 MHz CPU-Takt (05/2022):
00000h                                                           ;* HL-Registerwert bei der VDIP-Initialisierung
00000h                                                           ;  auf 600h gesetzt
00000h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
00000h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
00000h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
00000h                                                           ;  der Sound-Leiterplatte
00000h                                                           ;-------------------------------------------------
00000h                                                           ;ANPASSUNG FÜR AC1: WERO 03/2018
00000h                                                           ;* USB-TREIBER FÜR LADEN DER SONGS
00000h                                                           ;* Farbfähig mit Farbkarte
00000h                                                           ;* Farbwerte: Bit 7 6 5 4  3 2 1 0
00000h                                                           ;                 I B G R  I B G R
00000h                                                           ;                 HINTEN-  --VORN-
00000h                                                           ;* PLAYER (NACH BULBA) ALS INCLUDE
00000h                                                           ;* SPIELZEITBESTIMMUNG (NACH BULBA)
00000h                                                           ;* EINFACHE SPEKTRUMANZEIGE WIE IM SOUNDTRACKER 1.X
00000h                                                           ;-------------------------------------------------
00000h                                                           ;ASSEMBLER: ASIDE 
00000h                                                           ;#################################################
00000h            EMU:                  EQU       0              ;1=EMU-TEST TONLOS
00000h                                                           ;#################################################
00000h                                            
00000h            PROGR:                EQU       4000H          ;LADEADRESSE/PROGRAMMANFANG
00000h            MS30:                 EQU       07EBH          ;UP PAUSE
00000h            INLINE:               EQU       07F4H          ;UP STRING-EINGABE
00000h            GETCO:                EQU       07FDH          ;RÜCKKEHR ZUM MONITOR
00000h            BWS:                  EQU       17FFH          ;Bildschirmspeicher links oben
00000h            CURS:                 EQU       1800H          ;ADRESSE AKT. KURSORPOSITION
00000h            INANF:                EQU       181AH          ;ADRESSE STRINGANFANG EINGABE
00000h            COLTST:               EQU       181FH          ;Farb-Reset-Byte 00=keine Farbkarte
00000h            USBPIO:               EQU       0FCH           ;BASISADRESSE USB-PIO     DC?
00000h            AYBAS:                EQU       38H            ;AY-BASISADRESSE
00000h            CTCZK:                EQU       9CH            ;Zeitkonstante für 2 MHz
00000h            CTCINT:               EQU       PROGR+10H      ;Interrupttabelle CTC
00000h                                            
00000h            KAT:                  EQU       2000H          ;KATALOG-ANFANG
00000h            MAXKAT:               EQU       4000H          ;-"-     Ende+1
00000h                                            
00000h                                  IF        EMU=1
00000h            CTCBAS:               EQU       0H             ;INT. CTC-BASISADRESSE AC1
00000h            CTCKAN:               EQU       0              ;FREI: KAN. 0
00000h                                  ELSE      
00000h            CTCBAS:               EQU       3CH            ;CTC-BASISADRESSE
00000h            CTCKAN:               EQU       0              ;K0
00000h                                  ENDIF     
00000h                                                           ;-------------------------------------------------
00000h                                                           ;Q358:         EQU  0  ;nutzt AC1-Systemtakt 2 MHz
00000h                                                           ;höherer CPU-Takt führt zum
00000h                                                           ;schnelleren Abspielen
00000h            Q358:                 EQU       1              ;benutzt Quarz 3,57954 MHz
00000h                                                           ;CTC K0+K1 sind kaskadiert
00000h                                                           ;CPU-Takt ist variabel
00000h                                                           ;-------------------------------------------------
00000h                                                           ;PROGRAMMKOPF (4000)
00000h                                  ORG       PROGR          ;Programmanfang
04000h 0009330D00                       DEFB      0,9,"3",0DH,0  ;Startrahmen, Kennbuchstabe '3'
04005h C3044B                           JP        START0
04008h                                                           ;max. 8 Config-Bytes als Patch-Bereich:
04008h F0         ZK:                   DEFB      0F0H           ;IO-Adr. AC1 Farbkarte
04009h                                                           ;
04009h CF         F0:                   DEFB      0CFH           ;Grundfarbe Player, 
0400Ah                                                           ;00=System
0400Ah                                                           ;xx=benutzerdefiniert
0400Ah FF         F1:                   DEFB      0FFH           ;Farbe Titel-/Autor-Info
0400Bh                                                           ;00=Syste
0400Bh                                                           ;FF=System invers
0400Bh                                                           ;xx=benutzerdefiniert
0400Bh A0         ZG1:                  DEFB      0A0H           ;0AFh=waagerechter Strich ACC
0400Ch B4         ZG2:                  DEFB      0B4H           ;85hh=Säule ACC
0400Dh                                                           ;noch frei
0400Dh 00                               DEFB      0
0400Eh 00                               DEFB      0
0400Fh 00                               DEFB      0
04010h                                                           ;------------------------------------------------
04010h                                  ORG       CTCINT
04010h 0000000000                       DEFS      8,0            ;INT-Adressen CTC
04018h                                                           ;------------------------------------------------
04018h                                  INCLUDE   PT3TIME.INC    ;SPIELDAUERBERECHNUNG
04018h                                                           ;INCULDE FÜR SPIELDAUERBERECHNUNG PT3-SONGS
04018h                                                           ;-------------------------------------------------
04018h                                                           ;QUELLE:
04018h                                                           ;PT3 DURATION CALCULATOR
04018h                                                           ;AUTHOR SERGEY BULBA <VOROBEY@MAIL.KHSTU.RU>
04018h                                                           ;SUPPORT PAGE HTTP://BULBA.AT.KZ/
04018h                                                           ;(C)2005 S.V.BULBA
04018h                                                           ;-------------------------------------------------
04018h                                                           ;MODS WERO 01/2018:
04018h                                                           ; * IX-> IY
04018h                                                           ; * DIV16_8 ERGÄNZT FÜR UMRECHNUNG
04018h                                                           ;-------------------------------------------------
04018h                                                           ;BEZÜGE: 
04018h                                                           ;(MODADR)       ;ADRESSE SONGANFANG
