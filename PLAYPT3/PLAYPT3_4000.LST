0413Ch 1F41                             DEFW      PT3TC_NOP
0413Eh 1F41                             DEFW      PT3TC_NOP
04140h            PT3T_EXIT:                      
04140h 2ACF40                           LD        HL,(PT3TIME)   ;LÄNGE IN INTERRUPTS
04143h                                                           ;DIVISION: ./. 50 HZ => SEKUNDEN
04143h 0E32                             LD        C,50
04145h CD5141                           CALL      DIV16_8        ;HL:=HL/C, A=REST
04148h                                                           ;./. 60 => MINUTEN
04148h 0E3C                             LD        C,60
0414Ah CD5141                           CALL      DIV16_8        ;HL:=HL/C, A=REST
0414Dh 65                               LD        H,L            ;MINUTEN
0414Eh 6F                               LD        L,A            ;SEKUNDEN
0414Fh FB                               EI        
04150h C9                               RET       
04151h                                                           ;-------------------------------------------------
04151h            DIV16_8:                        
04151h AF                               XOR       A
04152h 0610                             LD        B,16
04154h            LOOPDIV:                        
04154h 29                               ADD       HL,HL
04155h 17                               RLA       
04156h B9                               CP        C
04157h 3802                             JR        C,$+4
04159h 91                               SUB       C
0415Ah 2C                               INC       L
0415Bh 10F7                             DJNZ      LOOPDIV
0415Dh C9                               RET       
0415Eh 00         PT3TSKACNT:           DEFB      0
0415Fh 00         PT3TSKBCNT:           DEFB      0
04160h 00         PT3TSKCCNT:           DEFB      0
04161h                                                           ;NAMENSBEZÜGE!
04161h                                                           ;(MODADR)                       ;ÜBERGABE SONGADRESSE
04161h                                                           ;CALL CALC                      ;BERECHNUNG, RÜCKGABE: H=MINUTEN, L=SEKUNDEN
04161h                                                           ;(PT3TIME)                      ;RÜCKGABE SPIELDAUER ALS ANZAHL INTERRUPTS
04161h                                                           ;--------------------------------------------------
04161h                                  INCLUDE   PT3PLAY.INC    ;der Player
04161h                                                           ;INCLUDE-DATEI FÜR PT3-PLAYER
04161h                                                           ;-------------------------------------------------
04161h                                                           ;BASIS:
04161h                                                           ;VORTEX TRACKER II V1.0 PT3 PLAYER FOR ZX SPECTRUM
04161h                                                           ;(C)2004,2007 S.V.BULBA <VOROBEY@MAIL.KHSTU.RU>
04161h                                                           ;HTTP://BULBA.UNTERGRUND.NET (HTTP://BULBA.AT.KZ)
04161h            RELEASE:              EQU       "7"            ;RELEASE NUMBER
04161h                                                           ;-------------------------------------------------
04161h                                                           ;MODS:
04161h                                                           ; * EINGEBAUTE INT-ERZEUGUNG PER CTC
04161h                                                           ; * ERSATZ IX DURCH IY WEGEN KC85/X
04161h                                                           ; * AY-ADRESSIERUNG ANGEPASST
04161h                                                           ; * AY-MIXERBITS IMMER BELASSEN!
04161h                                                           ; * POSITIONSZÄHLER EINGEFÜGT 
04161h                                                           ; * PAUSENFLAG EINGEFÜGT
04161h                                                           ; * INT-ZÄHLER EINGEFÜGT (PT3TIME)
04161h                                                           ;-------------------------------------------------
04161h                                                           ;NÖTIGE KONSTANTEN IM HAUPTPROGRAMM:
04161h                                                           ;AYBAS:     BASISADRESSE AY-3-8910
04161h                                                           ;CTCBAS:    BASISADRESSE DER CTC    
04161h                                                           ;CTCKAN:    KANAL DER CTC       
04161h                                                           ;CTCZK:     ZEITKONSTANTE
04161h                                                           ;CTCINT:    ANFANG INTERRUPTTABELLE
04161h                                                           ;Q358:      CTC-Kaskadierung K0+K1
04161h                                                           ;-------------------------------------------------
04161h 3D56544949                       DEFM      "=VTII PT3 Player r.",RELEASE,"=";IDENTIFIER
04176h                                                           ;BEZÜGE-------------------------------------------
04176h                                                           ;CALL   PLAY:   ;INIT CTC + PLAYER
04176h                                                           ;CALL   STOPP:  ;CTC INTERRUPT AUS, TON AUS
04176h                                                           ;CALL   MUTE:   ;NUR TON AUS
04176h                                                           ;-------------------------------------------------
04176h                                                           ;VARIABLEN:
04176h                                                           ;-------------------------------------------------
04176h 0000       MODADR:               DEFW      0              ;ÜBERGABE SONGADRESSE
04178h 00         SETUP:                DEFB      0              ;STATUS-RÜCKGABE 
04179h                                                           ;SET BIT0 TO 1, IF YOU WANT TO PLAY WITHOUT LOOPING
04179h                                                           ;BIT7 IS SET EACH TIME, WHEN LOOP POINT IS PASSED
04179h 0000       CRPSPTR:              DEFW      0              ;POINTER TO CURRENT POSITION VALUE IN PT3 MODULE;
0417Bh                                                           ;AFTER INIT (START+11) POINTS TO POSTION0-1
0417Bh 00         POSI:                 DEFB      0              ;POSITION IN MUSTERLISTE
0417Ch 00         PAUSE:                DEFB      0              ;FLAG FÜR PAUSIEREN
0417Dh                                                           ;AYREGS:        ;TABELLENANFANG AUSGABEINHALTE DER 13 AY-REGISTER
0417Dh                                                           ;Z.B. (AYREGS+8) = AMPLITUDE KANAL A
0417Dh                                                           ;-------------------------------------------------
0417Dh                                                           ;AUTO-LOOP
0417Dh 217841     CHECKLP:              LD        HL,SETUP
04180h CBFE                             SET       7,(HL)         ;ENDEBIT SETZEN
04182h CB46                             BIT       0,(HL)         ;LOOP?
04184h C8                               RET       Z              ;JA
04185h                                                           ;SONGENDE
04185h E1                               POP       HL             ;PLAY VERLASSEN
04186h 21A248                           LD        HL,DELYCNT
04189h 34                               INC       (HL)
0418Ah 216648                           LD        HL,CHANA+CHP_NTSKCN
0418Dh 34                               INC       (HL)
0418Eh AF         MUTE:                 XOR       A
0418Fh 67                               LD        H,A
04190h 6F                               LD        L,A
04191h 32F148                           LD        (AYREGS+8),A   ;AMPLA
04194h 22F248                           LD        (AYREGS+9),HL  ;AMPLB
04197h C39547                           JP        ROUT_A0        ;AY-REGISTER SETZEN
0419Ah                                                           ;-------------------------------------------------
0419Ah F3         ISR:                  DI        
0419Bh ED73A848                         LD        (SPSV2),SP     ;Stackpointer merken
0419Fh 31E948                           LD        SP,STACK2      ;lokaler Stack
041A2h FDE5                             PUSH      IY
041A4h E5                               PUSH      HL
041A5h D5                               PUSH      DE
041A6h C5                               PUSH      BC
041A7h F5                               PUSH      AF
041A8h 08                               EX        AF,AF'
041A9h F5                               PUSH      AF
041AAh 3A7C41                           LD        A,(PAUSE)
041ADh B7                               OR        A
041AEh 2003                             JR        NZ,PAUSE1      ;KEIN FORTSCHRITT
041B0h CD9446                           CALL      PLAY_Q         ;1 SEGMENT ABSPIELEN
041B3h F1         PAUSE1:               POP       AF
041B4h 08                               EX        AF,AF'
041B5h F1                               POP       AF
041B6h C1                               POP       BC
041B7h D1                               POP       DE
041B8h E1                               POP       HL
041B9h FDE1                             POP       IY
041BBh ED7BA848                         LD        SP,(SPSV2)     ;alten Stackpointer zurückholen
041BFh FB                               EI        
041C0h                                                           ;ERST HIER FREIGEBEN, PLAYER MANIPULIERT STACK!!!!
041C0h ED4D                             RETI      
041C2h                                                           ;-------------------------------------------------        
041C2h            STOPP:                                         ;SONG ANHANLTEN, INTERRUPT STOPPEN
041C2h                                                           ;REGISTERWERTE FUER "ALLES AUS
041C2h F3                               DI        
041C3h 3E43                             LD        A,#43          ;STEUERWORT (INT AUS)
041C5h                                  IF        Q358=1         ;K0+K1 KASKADIERT
041C5h D33D                             OUT       (CTCBAS+1),A
041C7h                                  ELSE                     ;nur KAN. x
041C7h                                  OUT       (CTCBAS+CTCKAN),A
041C7h                                  ENDIF     
041C7h 21D741     STOPP1:               LD        HL,STOPP2      ;REGISTERWERTE FUER ANHALTEN
041CAh 11E948                           LD        DE,AYREGS      ;TABELLE AUSGABE-WERTE
041CDh 010E00                           LD        BC,14          ;14 REGISTERWERTE
041D0h EDB0                             LDIR                     ;UMLADEN        
041D2h CD9447                           CALL      ROUT           ;IN AY3 SCHREIBEN
041D5h FB                               EI        
041D6h C9                               RET       
041D7h 0000000000 STOPP2:               DEFB      0,0,0,0,0,0,0,0FFH,0,0,0,0,0,0
041E5h                                                           ;-------------------------------------------------
041E5h                                                           ;ABSPIEL STARTEN
041E5h            PLAY:                                          ;(1)Arbeitszellen löschen-----------------
041E5h 214B48                           LD        HL,VARS
041E8h 3600                             LD        (HL),0
041EAh 114C48                           LD        DE,VARS+1
041EDh 01AD00                           LD        BC,VAR0END-1-VARS
041F0h EDB0                             LDIR      
041F2h                                                           ;(2) CTC INITIALISIEREN-------------------
041F2h F3                               DI        
041F3h 219A41                           LD        HL,ISR         ;ADR. PLAYERROUTINE
041F6h                                                           ;#################################################
041F6h                                  IF        Q358=1         ;K0+K1 KASKADIERT
