0410Dh 56                               LD        D,(HL)
0410Eh D5                               PUSH      DE
0410Fh 112010     PT3TPD:               LD        DE,#1020
04112h 18CC                             JR        PT3TPD1
04114h            PT3TC_DELAY:                    
04114h 0A                               LD        A,(BC)
04115h 03                               INC       BC
04116h 32CC40                           LD        (PT3T_DL),A
04119h C9                               RET       
0411Ah            PT3TC_PORTM:                    
