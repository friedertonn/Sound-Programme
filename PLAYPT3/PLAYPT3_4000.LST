0411Fh            PT3TC_NOP:                      
0411Fh C9                               RET       
04120h                                                           ;ALL 16 ADDRESSES TO PROTECT FROM BROKEN PT3 MODULES
04120h            PT3TSPCCOMS:                    
04120h 1F41                             DEFW      PT3TC_NOP
04122h 1C41                             DEFW      PT3TC_GLISS
04124h 1A41                             DEFW      PT3TC_PORTM
04126h 1E41                             DEFW      PT3TC_SMPOS
04128h 1E41                             DEFW      PT3TC_ORPOS
0412Ah 1D41                             DEFW      PT3TC_VIBRT
0412Ch 1F41                             DEFW      PT3TC_NOP
