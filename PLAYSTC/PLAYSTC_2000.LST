00000h                                                           ;-------------------------------------------------
00000h                                                           ;USB-PLAYER AC1 FÜR STC-SONGS
00000h                                                           ;WERO '2018
00000h                                                           ;PLAYER MACHT INTENSIVE STACKARBEIT, 
00000h                                                           ;TIEFE SYSTEMSTACK REICHT NICHT, VERLAGERUNG NÖTIG!
00000h                                                           ;version:    EQU  0             ;int. CTC AC1, K0
00000h            VERSION:              EQU       1              ;CTC auf Soundkarte
00000h                                                           ;-------------------------------------------------
00000h                                                           ;VERSION 1.3:
00000h                                                           ;Anpassung für AC1-2010 mit 4 MHz CPU-Takt (05/2022):
00000h                                                           ;* HL-Registerwert bei der VDIP-Initialisierung
00000h                                                           ;  auf 600h gesetzt
00000h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
00000h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
00000h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
00000h                                                           ;  der Sound-Leiterplatte
00000h                                                           ;* Änderungen in der ISR-Routine bei der Int.-Annahme
00000h                                                           ;-------------------------------------------------
00000h                                                           ;MONITOR- UND SPEICHERBEZÜGE----------------------
00000h            MS30:                 EQU       07EBH          ;UP PAUSE
00000h            INLINE:               EQU       07F4H          ;UP STRING-EINGABE
00000h            GETCO:                EQU       07FDH          ;RÜCKKEHR ZUM MONITOR
00000h            BWS:                  EQU       17FFH          ;Bildschirmspeicher links oben
00000h            CURS:                 EQU       1800H          ;ADRESSE AKT. KURSORPOSITION
00000h            INANF:                EQU       181AH          ;ADRESSE STRINGANFANG EINGABE
00000h                                            
00000h            PROGR:                EQU       2000H          ;LADEADRESSE/PROGRAMMANFANG
00000h            ABL:                  EQU       6000H          ;ABLAGE DATEINAMEN FÜR SERIENABSPIEL
00000h            ABLLEN:               EQU       3000H          ;max. Länge Ablagebereich
00000h                                                           ;Für Include nötig---------------------------------
00000h                                                           ;x0001: EQU     38h             ;AY-BASISADRESSE 
00000h            USBPIO:               EQU       0FCH           ;USB.PIO
00000h            CTCZK:                EQU       9CH            ;Zeitkonstante für 2 MHz
00000h                                            
00000h                                  IF        VERSION=0      ;Interne CTC AC1 K3
00000h            CTCBAS:               EQU       0              ;CTC-Basisadresse
00000h            CTCCHN:               EQU       0              ;Kanal
00000h                                  ELSE                     ;CTC auf Soundkarte, K0
00000h            CTCBAS:               EQU       3CH            ;CTC-Basisadresse
00000h            CTCCHN:               EQU       0              ;Kanal
00000h                                  ENDIF     
00000h            CTCINT:               EQU       PROGR+10H      ;Interrupttabelle CTC
00000h            WORK:                 EQU       PROGR+18H      ;Eingebettete Arbeitszellen
00000h                                                           ;-------------------------------------------------
00000h                                                           ;Q358:         EQU  0  ;nutzt AC1-Systemtakt 2 MHz
00000h                                                           ;höherer CPU-Takt führt zum
00000h                                                           ;schnelleren Abspielen
00000h            Q358:                 EQU       1              ;benutzt Quarz 3,57954 MHz
00000h                                                           ;CTC K0+K1 sind kaskadiert
00000h                                                           ;CPU-Takt ist variabel
00000h                                                           ;-------------------------------------------------
00000h                                  ORG       PROGR          ;Programmanfang
02000h 0009780D                         DEFB      0,9,"x",0DH    ;Startrahmen, Kennbuchstabe a
02004h 3E20                             LD        A,HI PROGR     ;20h
02006h ED47                             LD        I,A            ;IV-Säule verbiegen
02008h 310020                           LD        SP,PROGR       ;Stack: < 2000
0200Bh C36A25                           JP        START0
0200Eh                                                           ;-------------------------------------------------
0200Eh 0000                             ORG       CTCINT         ;8 Bytes für IV CTC
02010h                                                           ;-------------------------------------------------
02010h 0000000000                       ORG       WORK           ;Raum für Arbeitszellen
02018h 0000000000                       DEFS      128
02098h                                                           ;PLAYER-BEZÜGE:
02098h            ANFANG:               EQU       WORK           ;ÜBERGABE LIEDANFANG
02098h            ANZAHL:               EQU       WORK+2         ;ÜBERGABE ANZAHL LIEDABSPIELE
02098h            MUSTER:               EQU       WORK+0DH       ;ANZAHL  MUSTER IM SONG
02098h            POSI:                 EQU       WORK+35H       ;ABGESPIELTE MUSTERANZAHL
02098h            MISCHER:              EQU       WORK+3EH       ;MISCHER
02098h            LAUT_A:               EQU       WORK+3FH       ;LAUTSTÄRKE KANAL A  
02098h            LAUT_B:               EQU       WORK+40H       ;LAUTSTÄRKE KANAL B  
02098h            LAUT_C:               EQU       WORK+41H       ;LAUTSTÄRKE KANAL C
02098h                                                           ;
02098h            RAUSCHA:              EQU       WORK+48H       ;RAUSCHEN A
02098h            RAUSCHB:              EQU       WORK+49H       ;B
02098h            RAUSCHC:              EQU       WORK+4AH       ;C
02098h            RAUSCHK:              EQU       WORK+4BH       ;KANAL-MERKER FÜR RAUSCHEN
02098h                                                           ;USB-BEZÜGE:
02098h            DIRANZ:               EQU       WORK+82        ;ANZAHL BEI DIR
02098h            DIRPS:                EQU       DIRANZ+2       ;1 BYTE EINTRÄGE PRO DIR SEITE
02098h            MENGE:                EQU       DIRPS+1        ;4 BYTES LADEN /SICHERN
02098h            RAMADR:               EQU       MENGE+4        ;2 BYTES
02098h            INBUFF:               EQU       RAMADR+2       ;EINGABEPUFFER 13
02098h            NAMBUF:               EQU       INBUFF+13      ;PUFFER DATEINAME  13 ZEICHEN
02098h            DIRFLG:               EQU       NAMBUF+13      ;FLAG FÜR SERIENABSPIEL
02098h            KATPOS:               EQU       DIRFLG+1       ;2 BYTES
02098h            MAXWDH:               EQU       KATPOS+2       ;1 BYTE
02098h            SONGNR:               EQU       MAXWDH+1       ;2 Bytes!
02098h                                                           ;-------------------------------------------------      
02098h            PLAYER:                         
02098h                                  INCLUDE   "AYPLAC1.INC"
02098h                                                           ;#################################################
02098h                                                           ;INCLUDE-FILE "PLAYER-ENGINE"
02098h                                                           ;FÜR STC-PLAYER MIT AY-3-8910 
02098h                                                           ;Version für AC1
02098h                                                           ;#################################################
02098h                                                           ;-------------------------------------------------
02098h                                                           ;ORIGINAL-VERÖFFENTLICHUNGEN:
02098h                                                           ;"MUSIK-TÜRKLINGEL MIT DEM AUDIO-COPROZESSOR AY8910"
02098h                                                           ;MAGAZIN 'RADIO', 1998/6, S. 42 + 43 (RUSSISCH)
02098h                                                           ;http://www.radioman-portal.ru/magazin/radio/1998/6.php
02098h                                                           ;
02098h                                                           ;ABSPIELROUTINE FÜR ZX81 MIT AY-3-8910-ADAPTER
02098h                                                           ;http://www.sinclairzxworld.com/viewtopic.php?t=528&start=100
02098h                                                           ;-------------------------------------------------
02098h                                                           ;PRINZIP CTC-TEIL: ENTWICKLERTEAM "M066"
02098h                                                           ;BEARBEITUNG, INCLUDE UND DOKU: WERO 10/2017
02098h                                                           ;ASSEMBLER: ASIDE
02098h                                                           ;-------------------------------------------------
02098h                                                           ;VERSION 1.1:
02098h                                                           ;* ISR GEÄNDERT
02098h                                                           ;* ARBEITSZELLEN STC-PLAYER VOR START GELÖSCHT
02098h                                                           ;* MISCHERBITS PORTREGISTER: BEI SONG-START/ENDE AUF EINGABE
02098h                                                           ;-------------------------------------------------
02098h                                                           ;VERSION 1.2:
02098h                                                           ;* MISCHERBITS PORTREGISTER: BLEIBEN IMMER UNANGETASTET
02098h                                                           ;Version 1.2.13
02098h                                                           ;KW 19.11.2017 (Klaus Wilfling)
02098h                                                           ;Anpassungen an K1520-SOUND-Karte 
02098h                                                           ;Bastelsystem mit ZRE K2526 unter CP/A, SCPX 
02098h                                                           ;SOUND-CTC Interruptsäule-F7D8h I=F7h, IV=D8h
02098h                                                           ;IO-Adresse der SOUND-Karte = 38h
02098h                                                           ;SOUND-Karten CTC Kanal 0 als 20ms Zeitgeber
02098h                                                           ;Version 1.2.14
02098h                                                           ;KW 03.02.2018
02098h                                                           ;Anpassung an unterschiedliche Rechnersysteme unter CP/M Klone
02098h                                                           ;Anpasssung wegen Problemen mit K8915 unter SCP8915
02098h                                                           ;zusätzlicher Stack für Interruptroutine für SCPX empfohlen
02098h                                                           ;-------------------------------------------------
02098h                                                           ;VERSION 1.3:
02098h                                                           ;Anpassung für AC1-2010 mit 4 MHz CPU-Takt (05/2022):
02098h                                                           ;* CTC Kanäle K0+K1 kaskadiert und Nutzung des 
02098h                                                           ;  Quarzes 3,57954 MHz für den Interrupt
02098h                                                           ;* Definition Q358=1 bei Nutzung des Quarzes auf
02098h                                                           ;  der Sound-Leiterplatte
02098h                                                           ;* Änderungen in der ISR-Routine bei der Int.-Annahme
02098h                                                           ;-------------------------------------------------
02098h                                                           ;ANFORDERUNGEN AN HAUPTPROGRAMM:
02098h                                                           ;* DARF LABELS X0001...X0087 NICHT BENUTZEN
02098h                                                           ;* MUSS ARBEITSZELLENBEGINN MIT LABEL 'WORK' DEFINIEREN!
02098h                                                           ;* MUSS FOLGENDE KONSTANTEN BEREITSTELLEN:
02098h                                                           ;CTCBAS: EQU     0                  ;CTC-Basisadresse
02098h                                                           ;CTCCHN: EQU     3                  ;CTC-Kanal
02098h                                                           ;CTCZK:  EQU     9Ch                ;CTC-Zeitkonstante
02098h                                                           ;CTCINT: EQU     PROGR+10h          ;LAGE Interrupttabelle CTC
02098h                                                           ;                         (8er Schritte, I-Register beachten!)
02098h                                                           ;Q358:   EQU     1                  ;CTC-Kaskadierung K0+K1
02098h                                                           ;-------------------------------------------------
02098h                                                           ;SOFERN 38H NICHT GEEIGNET, MUSS BASISADRESSE HIER ANGEPASST WERDEN:
02098h            X0001:                EQU       #38            ;AY-BASISADRESSE  (K1520-SOUND)
02098h                                                           ;-------------------------------------------------
02098h                                                           ;PLAYER-AREBEITSZELLEN AB WORK
02098h            X0004:                EQU       WORK           ;WORD   ;WORK     ABLAGE LIEDANFANG   
02098h            X0005:                EQU       X0004+2        ;BYTE   ;WORK+#02 ABLAGE ANZAHL SONG-WIEDERHOLUNGEN 
02098h            X0006:                EQU       X0005+1        ;WORD   ;WORK+#03 POSITIONS-ZEIGER
02098h            X0007:                EQU       X0006+2        ;WORD   ;WORK+#05 ORNAMENT-ZEIGER      
02098h            X0008:                EQU       X0007+2        ;WORD   ;WORK+#07 PATTERN-ZEIGER       
02098h            X0009:                EQU       X0008+2        ;WORD   ;WORK+#09 POINTER 1. SAMPLE NR       
02098h            X0010:                EQU       X0009+2        ;BYTE   ;WORK+#0B GLOBAL DELAY SONG  
02098h            X0011:                EQU       X0010+1        ;BYTE   ;WORK+#0C GLOBAL DELAY WORK
02098h            X0012:                EQU       X0011+1        ;BYTE   ;WORK+#0D ANZAHL  PATTERN IM SONG 
02098h            X0013:                EQU       X0012+1        ;WORD   ;WORK+#0E ADRESSE PATTERN KANAL A 
02098h            X0014:                EQU       X0013+2        ;WORD   ;WORK+#10 ADRESSE PATTERN KANAL B
02098h            X0015:                EQU       X0014+2        ;WORD   ;WORK+#12 ADRESSE PATTERN KANAL C
02098h            X0016:                EQU       X0015+2        ;BYTE   ;WORK+#14 ENDEMARKE (FF)
02098h            X0017:                EQU       X0016+1        ;WORD   ;WORK+#15
02098h                                                           ;KANAL A------------------------------------------
02098h            X0018:                EQU       X0017+2        ;BYTE   ;WORK+#17 INDEX A
02098h                                                           ;BYTE   ;WORK+#18 NOTENNNUMMER
02098h                                                           ;BYTE   ;WORK+#19 PAUSE ZWISCHEN NOTEN
02098h            X0019:                EQU       X0018+3        ;WORD   ;WORK+#1A SAMPLEADRESSE
02098h            X0020:                EQU       X0019+2        ;WORD   ;WORK+#1C ORNAMENTADRESSE
02098h            X0021:                EQU       X0020+2        ;3XBYTE ;WORK+#1E 
02098h                                                           ;KANAL B------------------------------------------
02098h            X0022:                EQU       X0021+3        ;BYTE   ;WORK+#21 INDEX B
02098h                                                           ;BYTE   ;WORK+#22 NOTENNNUMMER
02098h                                                           ;BYTE   ;WORK+#23 PAUSE ZWISCHEN NOTEN
02098h            X0023:                EQU       X0022+3        ;WORD   ;WORK+#24 SAMPLEADRESSE
02098h            X0024:                EQU       X0023+2        ;WORD   ;WORK+#26 ORNAMENTADRESSE
02098h            X0025:                EQU       X0024+2        ;3XBYTE ;WORK+#28
02098h                                                           ;KANAL C------------------------------------------
02098h            X0026:                EQU       X0025+3        ;BYTE   ;WORK+#2B INDEX C
02098h                                                           ;BYTE   ;WORK+#2C NOTENNNUMMER
02098h                                                           ;BYTE   ;WORK+#2D PAUSE ZWISCHEN NOTEN
02098h            X0027:                EQU       X0026+3        ;WORD   ;WORK+#2E SAMPLEADRESSE
02098h            X0028:                EQU       X0027+2        ;WORD   ;WORK+#30 ORNAMENTADRESSE
02098h            X0029:                EQU       X0028+2        ;3XBYTE ;WORK+#32
02098h                                                           ;-------------------------------------------------
02098h            X0030:                EQU       X0029+3        ;BYTE   ;WORK+#35 ABGESPIELTE PATTERNANZAHL
02098h            X0031:                EQU       X0030+1        ;BYTE   ;WORK+#36 AKTUELLE PATTERNNUMMER
02098h                                                           ;-------------------------------------------------
02098h                                                           ;AUSZUGEBENDER BLOCK MIT AY3-PROGRAMMIERWERTEN
02098h            X0032:                EQU       X0031+1        ;BYTE   ;WORK+#37 REG. 0=TONHÖHE KANAL A FEIN
02098h                                                           ;BYTE   ;WORK+#38 REG. 1=TONHÖHE KANAL A GROB
02098h            X0033:                EQU       X0032+2        ;BYTE   ;WORK+#39 REG. 2=TONHÖHE KANAL B FEIN
02098h                                                           ;BYTE   ;WORK+#3A REG. 3=TONHÖHE KANAL B GROB
02098h            X0034:                EQU       X0033+2        ;BYTE   ;WORK+#3B REG. 4=TONHÖHE KANAL C FEIN
02098h                                                           ;BYTE   ;WORK+#3C REG. 5=TONHÖHE KANAL C GROB
02098h            X0035:                EQU       X0034+2        ;BYTE   ;WORK+#3D REG. 6=TONHÖHE RAUSCHEN
02098h            X0036:                EQU       X0035+1        ;BYTE   ;WORK+#3E REG. 7=MISCHER             
02098h            X0037:                EQU       X0036+1        ;BYTE   ;WORK+#3F REG. 8=LAUTSTÄRKE KANAL A  
02098h            X0038:                EQU       X0037+1        ;BYTE   ;WORK+#40 REG. 9=LAUTSTÄRKE KANAL B  
02098h            X0039:                EQU       X0038+1        ;BYTE   ;WORK+#41 REG.10=LAUTSTÄRKE KANAL C  
02098h            X0040:                EQU       X0039+1        ;BYTE   ;WORK+#42 REG.11=DAUER HÜLLKURVE FEIN
02098h                                                           ;BYTE   ;WORK+#43 REG.12=DAUER HÜLLKURVE GROB    
02098h            X0041:                EQU       X0040+2        ;BYTE   ;WORK+#44 REG.13=FORM HÜLLKURVE   
02098h            X0042:                EQU       X0041+1        ;WORD   ;WORK+#45 EFFEKT1
02098h            X0043:                EQU       X0042+2        ;BYTE   ;WORK+#47 EFFEKT2
02098h                                                           ;
02098h                                                           ;LETZTE ARBEITSZELLE: WORK+#47 = 00C7 BEI BEGINN AUF 0080
02098h                                                           ;-------------------------------------------------
02098h                                                           ;PROGRAMMANFANG PROG 
02098h                                                           ;-------------------------------------------------
02098h                                                           ;ayinc:  
02098h C3CC20                           JP        X0048          ;CALL PROG   = SONG LADEN+ABSPIELEN
0209Bh C3B520                           JP        X0045          ;CALL PROG+3 = GERÄUSCH LADEN+ABSPIELEN
0209Eh C3BA20                           JP        X0046          ;CALL PROG+6 = SOUND OFF   
020A1h 000000                           DEFS      3,0            ;RESERVE
020A4h 000000                           DEFS      3,0            ;RESERVE       
020A7h                                                           ;REGISTERWERTE FUER "ALLES AUS"-------------------
020A7h 0000000000 X0044:                DEFB      #00,#00,#00,#00,#00,#00,#00
020AEh FF00000000                       DEFB      #FF,#00,#00,#00,#00,#00,#01
020B5h                                                           ;GERÄUSCH LADEN+ABSPIELEN-------------------------
020B5h 2A1820     X0045:                LD        HL,(X0004)     ;TABELLE REGISTERWERTE
020B8h 1807                             JR        X0047
020BAh                                                           ;#############################################################        
020BAh                                                           ;UP "SOUND STOPPEN"
020BAh            X0046:                                         ;CTC-INTERRUPT Kx AUS, GGF ANPASSEN!
020BAh 3E43                             LD        A,#43          ;STEUERWORT (INT AUS)
020BCh                                  IF        Q358=1         ;K0+K1 KASKADIERT
020BCh D33D                             OUT       (CTCBAS+1),A
020BEh                                  ELSE                     ;nur KAN. x
020BEh                                  OUT       (CTCBAS+CTCCHN),A
020BEh                                  ENDIF     
020BEh 21A720                           LD        HL,X0044       ;REGISTERWERTE FUER ANHALTEN
020C1h                                                           ;##############################################################
020C1h 114F20     X0047:                LD        DE,X0032       ;
020C4h 010E00                           LD        BC,14          ;14 REGISTERWERTE
020C7h EDB0                             LDIR                     ;UMLADEN
020C9h C33324                           JP        X0084          ;IN AY3 SCHREIBEN
020CCh                                                           ;-------------------------------------------------
020CCh                                                           ;SONGDATEN LADEN, CTC PROGRAMMIEREN, STARTEN
020CCh F3         X0048:                DI        
020CDh 3E0A                             LD        A,#0A
020CFh 325D20                           LD        (X0042),A      ;STARTWERT EFFEKT1
020D2h AF                               XOR       A
020D3h 325F20                           LD        (X0043),A      ;STARTWERT EFFEKT2 
020D6h 3D                               DEC       A              ;FF
020D7h 322C20                           LD        (X0016),A      ;1. ENDE-WERT SETZEN!   
020DAh                                                           ;KOPFDATEN DES LIEDES AUSLESEN------------
020DAh 2A1820                           LD        HL,(X0004)     ;LIEDANFANG
020DDh 7E                               LD        A,(HL)         ;1. ZEICHEN = "GLOBAL DELAY"
020DEh 322320                           LD        (X0010),A      ;ABLEGEN
020E1h 23                               INC       HL             ;POSITIONSZEIGER
020E2h CDDF21                           CALL      X0055          ;HOLEN =>DE
020E5h 1A                               LD        A,(DE)         ;ANZAHL PATTERN IM SONG
020E6h 13                               INC       DE             ;DE=ADR. 1. PATTERNNNUMMER
020E7h 3C                               INC       A              ;+1
020E8h 322520                           LD        (X0012),A      ;ANZAHL PATTERN IM SONG + 1 ABLEGEN
020EBh ED531B20                         LD        (X0006),DE     ;ADRESSE 1. PATTERNNUMMER
020EFh                                            
020EFh CDDF21                           CALL      X0055          ;ORNAMENTZEIGER HOLEN
020F2h ED531D20                         LD        (X0007),DE     ;ABLEGEN
020F6h D5                               PUSH      DE             ;MERKEN
020F7h                                            
020F7h CDDF21                           CALL      X0055          ;PATTERNZEIGER HOLEN
020FAh ED531F20                         LD        (X0008),DE     ;ABLEGEN
020FEh                                            
020FEh 211B00                           LD        HL,#001B       ;OFFSET 1. SAMPLENUMMER
02101h CDE421                           CALL      X0056          ;+LIEDANFANG
02104h EB                               EX        DE,HL          ;HL=ABSOLUTADRESSE RAM
02105h 222120                           LD        (X0009),HL     ;ABLEGEN
02108h                                            
02108h 212C20                           LD        HL,X0016       ;DORT FF,00
0210Bh 222620                           LD        (X0013),HL
0210Eh                                            
0210Eh 212D20                           LD        HL,X0017       ;BEREICH
02111h 112E20                           LD        DE,X0017+1
02114h 012C00                           LD        BC,#002C
02117h 70                               LD        (HL),B         ;LÖSCHEN
02118h EDB0                             LDIR      
0211Ah                                            
0211Ah E1                               POP       HL             ;AB HL=ORNAMENTZEIGER, 
0211Bh                                                           ;JEDES ORNAMENT IST 33 BYTES LANG
0211Bh 012100                           LD        BC,#0021       ;IN 33ER SCHRITTEN
0211Eh AF                               XOR       A              ;00
0211Fh CDDA21                           CALL      X0054          ;SUCHEN
02122h 3D                               DEC       A
02123h 323620                           LD        (X0021),A      ;#FF = ENDE ORNAMENT SETZEN
02126h 324020                           LD        (X0025),A      ;#FF
02129h 324A20                           LD        (X0029),A      ;#FF
0212Ch 3E01                             LD        A,#01
0212Eh 322420                           LD        (X0011),A      ;STARTWERT GLOBAL DELAY WORK
02131h 23                               INC       HL
02132h 223420                           LD        (X0020),HL
02135h 223E20                           LD        (X0024),HL
02138h 224820                           LD        (X0028),HL
0213Bh CD3324                           CALL      X0084          ;REGISTER BESCHREIBEN
0213Eh                                                           ;#########################################
0213Eh                                                           ;CTC Initialisieren:
0213Eh                                                           ;als Allererstes den IV eintragen, dann den Rest...
0213Eh F3                               DI        
0213Fh 215B21                           LD        HL,X0049       ;ADR. PLAYERROUTINE
02142h                                                           ;#########################################
02142h                                  IF        Q358=1         ;K0+K1 KASKADIERT
02142h 221220                           LD        (CTCINT+2),HL  ;ALS INTERRUPT-ADRESSE K1
02145h                                  ELSE                     ;nur KAN. x
02145h                                  LD        (CTCINT+CTCCHN*2),HL;ALS INTERRUPT-ADRESSE Kx
02145h                                  ENDIF     
02145h 3E10                             LD        A,LO CTCINT    ;IV
02147h D33C                             OUT       (CTCBAS),A     ;K0 --> IV wird immer auf K0 geladen
02149h                                                           ;#########################################
02149h                                  IF        Q358=1         ;K0+K1 KASKADIERT
02149h 3E47                             LD        A,#47          ;STEUERWORT, KEIN INT
0214Bh D33C                             OUT       (CTCBAS),A     ;K0   
0214Dh 3E9D                             LD        A,#9D          ;ZK1=157
0214Fh D33C                             OUT       (CTCBAS),A
02151h 3EC7                             LD        A,#C7          ;STEUERWORT, INT!
02153h D33D                             OUT       (CTCBAS+1),A   ;K1
02155h 3E39                             LD        A,#39          ;ZK2=57 
02157h D33D                             OUT       (CTCBAS+1),A   ;FÜR 3,57954 MHz --> 49,999 Hz
02159h                                  ELSE                     ;nur KAN. x
02159h                                  LD        A,0A7H         ;STEUERWORT, MIT INT, VT 256
02159h                                  OUT       (CTCBAS+CTCCHN),A;Kx  
02159h                                  LD        A,CTCZK        ;ZK an Taktfrequenz anpassen!
02159h                                  OUT       (CTCBAS+CTCCHN),A
02159h                                  ENDIF     
02159h                                                           ;#########################################
02159h FB                               EI                       ;SOUND ON!
0215Ah C9                               RET       
0215Bh                                                           ;-------------------------------------------------
0215Bh                                                           ;ROUTINE WIRD ALLER 1/50 SEKUNDEN AUFGERUFEN UND 
0215Bh                                                           ;VERANLASST 1 PROGRAMMIERUNG DES AY-3-8910 
0215Bh F3         X0049:                DI        
0215Ch ED731E25                         LD        (SPSV2),SP     ;Stackpointer merken
02160h 315F25                           LD        SP,STACK2      ;lokaler Stack
02163h FDE5                             PUSH      IY
02165h E5                               PUSH      HL
02166h D5                               PUSH      DE
02167h C5                               PUSH      BC
02168h F5                               PUSH      AF
02169h 08                               EX        AF,AF'
0216Ah F5                               PUSH      AF
0216Bh CD8621                           CALL      X0051          ;1x AY PROGRAMMIEREN
0216Eh 3A1A20                           LD        A,(X0005)      ;WIEDERHOLUNG SONG?
02171h B7                               OR        A              ;FERTIG?
02172h 2003                             JR        NZ,X0050       ;NEIN
02174h CDBA20                           CALL      X0046          ;JA: CTC-INTERRUPT AUS!
02177h F1         X0050:                POP       AF
02178h 08                               EX        AF,AF'
02179h F1                               POP       AF
0217Ah C1                               POP       BC
0217Bh D1                               POP       DE
0217Ch E1                               POP       HL
0217Dh FDE1                             POP       IY
0217Fh ED7B1E25                         LD        SP,(SPSV2)     ;alten Stackpointer zurückholen
02183h FB                               EI        
02184h ED4D                             RETI      
02186h                                                           ;-----------------------------------------------------
02186h 3A2420     X0051:                LD        A,(X0011)      ;GLOBAL DELAY WORK (IN INTERRUPTS)
